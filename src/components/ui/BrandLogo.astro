---
/*
  브랜드 로고 자리
  - 로고 바꾸는 법: 로고 파일을 public/images/brand/logo.svg 로 넣기만 하면 됨 (코드 수정 없음)
    다른 이름·위치로 넣었다면 아래 LOGO_SRC 한 줄만 바꾸기
  - 어두운 바탕용(반전형) 로고가 따로 있으면 public/images/brand/logo-white.svg 로 넣기
    없으면 기본 로고를 흰색으로 바꿔서 보여줌
  - 파일이 없으면 "로고 준비중입니다" 자리가 보임
  - 빌드할 때 파일이 있는지 확인하므로, 파일을 넣은 뒤엔 dev 서버를 다시 켜거나 다시 빌드하기
  - animate 를 켜면 SVG를 페이지 안에 직접 넣어서, 심볼 가로줄이 위에서부터 한 줄씩 슥슥 그어지고
    이어서 글자가 떠오름. 감싸는 요소에 data-reveal 이 있어야 하고, 화면에 들어올 때(.is-visible) 시작
    (일러스트레이터에서 내보낸 SVG 구조 기준: 첫 번째 <g> 묶음 = 심볼 가로줄, 그 다음 <g> = 글자)
*/
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../../data/site';

const LOGO_SRC = '/images/brand/logo.svg';
const LOGO_WHITE_SRC = '/images/brand/logo-white.svg';

interface Props {
  class?: string;
  /** 'dark' = 어두운 바탕 위에 놓을 때 (흰 로고) */
  tone?: 'light' | 'dark';
  /** 심볼 가로줄이 차례로 그어지며 나타나는 연출 */
  animate?: boolean;
  /** animate 일 때 로고 색. 'currentColor' 로 주면 감싸는 요소의 글자색을 따라감 (배경 전환용) */
  fill?: string;
}
const { class: className, tone = 'light', animate = false, fill } = Astro.props;

const file = (src: string) => path.join(process.cwd(), 'public', src);
const has = (src: string) => fs.existsSync(file(src));
const hasWhite = tone === 'dark' && has(LOGO_WHITE_SRC);
const hasLogo = has(LOGO_SRC);
const src = hasWhite ? LOGO_WHITE_SRC : LOGO_SRC;

// SVG를 페이지에 직접 넣을 수 있게 정리
// - 파일 안 <style>(.cls-1 색)은 페이지 전체에 퍼져서 다른 로고 색까지 바꾸므로 빼고, 색은 <svg fill>로 줌
// - id 가 겹치지 않게 지움
// - 심볼 가로줄마다 위에서부터 순서(--i)를 붙임
function inlineSvg(src: string, forceWhite: boolean) {
  let svg = fs.readFileSync(file(src), 'utf8');
  const color = fill ?? (forceWhite ? '#fff' : (svg.match(/fill:\s*([^;}\s]+)/)?.[1] ?? 'currentColor'));
  svg = svg
    .replace(/<\?xml[^>]*\?>/, '')
    .replace(/<defs>[\s\S]*?<\/defs>/, '')
    .replace(/\s(?:id|data-name|class)="[^"]*"/g, '');

  const symbol = svg.match(/<g>((?:\s*<path[^>]*\/>)+)\s*<\/g>/);
  if (!symbol || symbol.index === undefined) return null;

  // 각 가로줄의 시작점 y로 위→아래 순서를 매김
  const paths = [...symbol[1].matchAll(/<path([^>]*)\/>/g)].map((m) => ({
    attrs: m[1],
    y: Number(m[1].match(/d="M[\d.-]+,([\d.-]+)/)?.[1] ?? 0),
  }));
  const order = [...paths].sort((a, b) => a.y - b.y);
  const stripes = paths
    .map((p) => {
      const i = order.indexOf(p);
      // 홀수 번째 줄은 오른쪽에서 그어짐
      return `<path class="logo-stripe${i % 2 ? ' from-right' : ''}" style="--i:${i}"${p.attrs}/>`;
    })
    .join('');

  const end = symbol.index + symbol[0].length;
  const typeAt = svg.indexOf('<g>', end);
  let rest = svg.slice(end);
  if (typeAt !== -1) rest = rest.replace('<g>', '<g class="logo-type">');

  return (
    svg.slice(0, symbol.index).replace('<svg ', `<svg class="h-full w-full" fill="${color}" aria-hidden="true" `) +
    `<g class="logo-symbol">${stripes}</g>` +
    rest
  );
}

const inline = animate && (hasWhite || hasLogo) ? inlineSvg(src, tone === 'dark' && !hasWhite) : null;
---

<div class:list={['w-full', className]}>
  {inline ? (
    <div class="logo-anim h-full w-full" role="img" aria-label={`${site.name} 로고`} set:html={inline} />
  ) : hasWhite || hasLogo ? (
    <img
      src={src}
      alt={`${site.name} 로고`}
      class:list={['h-full w-full object-contain', tone === 'dark' && !hasWhite && 'brightness-0 invert']}
    />
  ) : (
    <div
      class:list={[
        'flex h-full w-full items-center justify-center rounded-xl border border-dashed',
        tone === 'dark' ? 'border-white/30 text-white/60' : 'border-ink/20 text-muted',
      ]}
    >
      <p class="text-center text-sm">로고 준비중입니다</p>
    </div>
  )}
</div>

<style is:global>
  /* 움직임 모드에서, 감싸는 data-reveal 요소가 화면에 들어오면(.is-visible) 시작 */
  .motion .logo-anim .logo-stripe,
  .motion .logo-anim .logo-type { opacity: 0; }

  /* 가로줄: 줄마다 왼쪽 · 오른쪽에서 번갈아 슥 그어짐 */
  .logo-anim .logo-stripe { transform-box: fill-box; transform-origin: left center; }
  .logo-anim .logo-stripe.from-right { transform-origin: right center; }
  .motion .is-visible .logo-anim .logo-stripe {
    animation: logo-stripe-in 0.7s cubic-bezier(0.65, 0, 0.2, 1) calc(250ms + var(--i) * 80ms) both;
  }
  @keyframes logo-stripe-in {
    from { opacity: 0; transform: scaleX(0); }
    30% { opacity: 1; }
    to { opacity: 1; transform: scaleX(1); }
  }

  /* 글자: 가로줄이 거의 다 그어질 즈음 아래에서 살짝 떠오름 */
  .logo-anim .logo-type { transform-box: fill-box; }
  .motion .is-visible .logo-anim .logo-type {
    animation: logo-type-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 1.1s both;
  }
  @keyframes logo-type-in {
    from { opacity: 0; transform: translateY(12%); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-anim .logo-stripe,
    .logo-anim .logo-type { opacity: 1 !important; animation: none !important; }
  }
</style>
