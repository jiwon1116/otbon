---
import { getImage } from 'astro:assets';
import { site } from '../../../data/site';
import { photo } from '../../../data/photos';

// 영상이 뜨기 전에 보이는 사진 (가볍게 webp로 변환)
const poster = await getImage({ src: photo(site.hero.poster), width: 1920, format: 'webp' });
---

<!--
  스크롤 히어로
  - 처음: 헤더 없이 흰 배경 가운데 큰 otbon 로고(작게 시작해 제 크기로 커지며 등장) + 화면 아래쪽에 둥근 원 모양 영상
  - 스크롤: 원이 커지며 영상이 화면을 꽉 채우고, 그동안 로고는 작아지며 사라짐. 영상이 커지기 시작하면 헤더가 내려옴
  - 영상이 꽉 차면 그 위로 제목 · 설명이 한 줄씩 떠오름
  - '동작 줄이기' 설정 사용자나 JS가 꺼진 환경에선 처음부터 꽉 찬 영상으로 보임
-->
<section id="hero" data-hero class="hero relative bg-ink">
  <!-- 로고를 누르면 오는 자리(/#home): 첫 로고 화면을 건너뛰고 영상이 화면을 꽉 채운 지점 -->
  <span id="home" class="hero-anchor" aria-hidden="true"></span>
  <div class="hero-stage sticky top-0 h-svh min-h-[560px] overflow-hidden">
    <div class="hero-media absolute inset-0 overflow-hidden bg-ink">
      <video
        class="hero-video absolute inset-0 h-full w-full object-cover"
        src={site.hero.video}
        poster={poster.src}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      <!-- 글씨가 잘 보이도록 전체를 고르게 살짝 어둡게 (아래만 진해지는 그림자 X) -->
      <div class="hero-shade absolute inset-0 bg-black/35"></div>
    </div>

    <!-- 첫 화면 로고 (세로형 로고 그림, public/images/brand/logo.svg). 바깥은 스크롤용, 안쪽은 처음 등장용
         높이는 화면 높이에 맞춰 줄어들어서, 낮은 화면에서도 아래 스크롤 안내와 겹치지 않음 -->
    <div class="hero-logo absolute inset-x-0 top-[38%] -translate-y-1/2" aria-hidden="true">
      <img
        src="/images/brand/logo.svg"
        alt=""
        class="hero-logo-in mx-auto h-[clamp(90px,17svh,160px)] w-auto"
      />
    </div>

    <!-- 스크롤 안내: 로고와 영상 원 사이. 가는 세로선 위로 짧은 선이 위에서 아래로 계속 흘러내림 -->
    <div class="hero-cue pointer-events-none absolute inset-x-0 flex flex-col items-center gap-4 text-ink/60" aria-hidden="true">
      <span class="text-[11px] font-semibold tracking-[0.3em]">SCROLL</span>
      <span class="hero-cue-line relative block h-12 w-px overflow-hidden bg-ink/15"></span>
    </div>

    <!-- 화면엔 안 보이는 페이지 제목 (검색엔진 · 화면낭독기용) -->
    <h1 class="sr-only">옷의 본(本)을 세우다.</h1>
  </div>
</section>

<style is:global>
  /* 움직임 모드: Layout의 head 스크립트가 <html>에 .motion 을 붙임 */
  .motion .hero { height: 240vh; background: var(--color-paper); }
  /* 영상이 꽉 차는 건 진행도 65% 지점. 여유 있게 75% 지점(= (섹션 높이 - 화면 높이) × 0.75)에 둠 */
  .hero-anchor { position: absolute; left: 0; top: 0; width: 1px; height: 1px; scroll-margin-top: 0; }
  .motion .hero-anchor { top: calc((240vh - 100svh) * 0.75); }
  .hero-logo { display: none; }
  .motion .hero-logo { display: block; will-change: transform, opacity; }

  /* 스크롤 안내 (움직임 모드에서만). 영상 원 윗부분(화면 72%)보다 조금 위 */
  .hero-cue { display: none; bottom: calc(28% + 28px); }
  .motion .hero-cue { display: flex; animation: hero-cue-in 0.8s ease 2s both; }
  /* 세로선 안에서 짧은 진한 선이 위 → 아래로 빠져나가고, 다시 위에서 들어옴 */
  .hero-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(40 40 40 / 0.7);
    transform: translateY(-100%);
    animation: hero-cue-flow 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes hero-cue-flow {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-cue-line::after { animation: none; transform: none; } }
  .motion .hero-media {
    /* JS가 정확한 값으로 바로 덮어씀. 아래는 첫 그림이 튀지 않게 하는 대략값 */
    clip-path: circle(20vw at 50% calc(72% + 20vw));
    will-change: clip-path;
  }
  .motion .hero-video { transform: scale(1.15); will-change: transform; }
  .motion .hero-shade { opacity: 0; }

  /* 처음 들어왔을 때 로고가 작게 시작해 천천히 제 크기로 커지며 나타남 */
  .motion .hero-logo-in { animation: hero-logo-in 2.4s cubic-bezier(0.33, 0, 0.15, 1) 0.15s both; }
  @keyframes hero-logo-in {
    from { transform: scale(0.55); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  import { onScrollFrame, motionOn, stickyProgress, clamp01, easeOut } from '../../../scripts/scroll';

  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero && motionOn()) {
    const stage = hero.querySelector<HTMLElement>('.hero-stage')!;
    const media = hero.querySelector<HTMLElement>('.hero-media')!;
    const video = hero.querySelector<HTMLElement>('.hero-video')!;
    const shade = hero.querySelector<HTMLElement>('.hero-shade')!;
    const logo = hero.querySelector<HTMLElement>('.hero-logo')!;
    const cue = hero.querySelector<HTMLElement>('.hero-cue')!;
    const header = document.getElementById('site-header');

    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // 원의 처음/끝 크기와 위치(px). 화면 크기가 바뀔 때마다 다시 잼
    let vw = 0, vh = 0, r0 = 0, cy0 = 0, r1 = 0;
    const measure = () => {
      vw = stage.offsetWidth;
      vh = stage.offsetHeight;
      // 처음 원: 지름이 화면 폭의 40% 정도, 윗부분만 화면 아래쪽(72% 지점)에 보이게
      r0 = Math.min(Math.max(vw * 0.2, 150), 340);
      // 세로로 긴 모바일 화면에선 72% 지점이면 원이 거의 통째로 보이므로,
      // 보이는 높이가 반지름의 85%를 넘지 않게 원 윗부분을 아래로 내려 반원 모양을 유지
      const top0 = Math.max(vh * 0.72, vh - r0 * 0.85);
      cy0 = top0 + r0;
      // 스크롤 안내도 원 바로 위에 붙어 따라 내려감
      cue.style.bottom = `${vh - top0 + 28}px`;
      // 마지막 원: 화면 가운데에서 네 모서리까지 덮는 크기
      r1 = Math.hypot(vw / 2, vh / 2) + 2;
    };

    const render = () => {
      // 0 ~ 65%: 원이 커져 화면을 채움. 나머지는 꽉 찬 상태로 잠깐 머무름
      const p = stickyProgress(hero);
      const e = easeInOut(clamp01(p / 0.65));

      const r = lerp(r0, r1, e);
      const cy = lerp(cy0, vh / 2, e);
      media.style.clipPath = `circle(${r}px at 50% ${cy}px)`;
      video.style.transform = `scale(${1.15 - 0.15 * e})`;
      shade.style.opacity = String(e);

      // 영상 원이 커지는 동안 로고는 작아지며 사라짐
      const g = easeOut(clamp01((e - 0.05) / 0.45));
      logo.style.opacity = String(1 - g);
      // 스크롤 안내는 조금만 내려도 바로 사라짐
      cue.style.opacity = String(1 - clamp01(p / 0.05));
      logo.style.transform = `scale(${1 - 0.6 * g})`; // 위치 보정(-50%)은 Tailwind translate 속성이 따로 맡음

      // 첫 화면(로고만 있을 때)엔 헤더를 숨기고, 영상 원이 커지기 시작하면 내려오게
      if (header) header.classList.toggle('is-hero-hidden', e < 0.12);

      // 원이 헤더 왼쪽 로고 자리까지 덮으면 헤더 글자를 흰색으로
      if (header) header.dataset.tone = Math.hypot(vw / 2 - vw * 0.06, cy - 32) < r ? 'dark' : 'light';
    };

    onScrollFrame(render, measure);
  }
</script>
