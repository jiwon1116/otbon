---
import { getImage } from 'astro:assets';
import { site } from '../../../data/site';
import { photo } from '../../../data/photos';

// 영상이 뜨기 전에 보이는 사진 (가볍게 webp로 변환)
const poster = await getImage({ src: photo(site.hero.poster), width: 1920, format: 'webp' });
---

<!--
  스크롤 히어로
  - 처음: 흰 배경 가운데 큰 제목 + 화면 아래쪽에 둥근 원 모양 영상
  - 스크롤: 원이 커지며 영상이 화면을 꽉 채우고, 제목은 흰 글씨로 바뀜
  - '동작 줄이기' 설정 사용자나 JS가 꺼진 환경에선 처음부터 꽉 찬 영상으로 보임
-->
<section id="hero" data-hero class="hero relative bg-ink">
  <div class="hero-stage sticky top-0 h-svh min-h-[560px] overflow-hidden">
    <div class="hero-media absolute inset-0 overflow-hidden bg-ink">
      <video
        class="hero-video absolute inset-0 h-full w-full object-cover"
        src={site.hero.video}
        poster={poster.src}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      <!-- 글씨가 잘 보이도록 전체를 고르게 살짝 어둡게 (아래만 진해지는 그림자 X) -->
      <div class="hero-shade absolute inset-0 bg-black/35"></div>
    </div>

    <div class="hero-copy absolute inset-x-0 top-[38%] -translate-y-1/2 px-4 text-center sm:px-6">
      <p class="hero-rise text-sm font-semibold sm:text-base" style="--d: 0ms">
        <span>기획부터 납품까지, 한 곳에서</span>
      </p>
      <h1 class="mt-5 text-4xl font-bold leading-[1.15] sm:mt-6 sm:text-6xl lg:text-7xl">
        <span class="hero-rise" style="--d: 120ms"><span>생각한 그대로,</span></span>
        <span class="hero-rise" style="--d: 240ms"><span>입을 수 있는 옷으로.</span></span>
      </h1>
      <p class="hero-sub mx-auto mt-8 max-w-md text-sm leading-relaxed text-white/85 sm:text-base">
        단체복부터 브랜드 OEM까지. 기획, 샘플, 생산, 납품을 {site.nameKo}이 한 번에 맡습니다.
      </p>
    </div>
  </div>
</section>

<style is:global>
  /* 기본(움직임 없음): 꽉 찬 영상 위에 흰 글씨 */
  .hero-copy { color: #fff; }

  /* 움직임 모드: Layout의 head 스크립트가 <html>에 .motion 을 붙임 */
  .motion .hero { height: 240vh; background: var(--color-paper); }
  .motion .hero-copy { color: var(--color-ink); }
  .motion .hero-media {
    /* JS가 정확한 값으로 바로 덮어씀. 아래는 첫 그림이 튀지 않게 하는 대략값 */
    clip-path: circle(20vw at 50% calc(72% + 20vw));
    will-change: clip-path;
  }
  .motion .hero-video { transform: scale(1.15); will-change: transform; }
  .motion .hero-shade { opacity: 0; }
  .motion .hero-sub { opacity: 0; }

  /* 처음 들어왔을 때 제목이 아래에서 올라오는 효과 */
  .hero-rise { display: block; }
  .motion .hero-rise { overflow: hidden; padding-bottom: 0.06em; }
  .motion .hero-rise > span {
    display: block;
    animation: hero-rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) both;
  }
  @keyframes hero-rise {
    from { transform: translateY(110%); }
    to { transform: translateY(0); }
  }
</style>

<script>
  import { onScrollFrame, motionOn, stickyProgress, clamp01, easeOut } from '../../../scripts/scroll';

  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero && motionOn()) {
    const stage = hero.querySelector<HTMLElement>('.hero-stage')!;
    const media = hero.querySelector<HTMLElement>('.hero-media')!;
    const video = hero.querySelector<HTMLElement>('.hero-video')!;
    const shade = hero.querySelector<HTMLElement>('.hero-shade')!;
    const copy = hero.querySelector<HTMLElement>('.hero-copy')!;
    const sub = hero.querySelector<HTMLElement>('.hero-sub')!;
    const header = document.getElementById('site-header');

    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // 원의 처음/끝 크기와 위치(px). 화면 크기가 바뀔 때마다 다시 잼
    let vw = 0, vh = 0, r0 = 0, cy0 = 0, r1 = 0;
    const measure = () => {
      vw = stage.offsetWidth;
      vh = stage.offsetHeight;
      // 처음 원: 지름이 화면 폭의 40% 정도, 윗부분만 화면 아래쪽(72% 지점)에 보이게
      r0 = Math.min(Math.max(vw * 0.2, 150), 340);
      cy0 = vh * 0.72 + r0;
      // 마지막 원: 화면 가운데에서 네 모서리까지 덮는 크기
      r1 = Math.hypot(vw / 2, vh / 2) + 2;
    };

    const render = () => {
      // 0 ~ 65%: 원이 커져 화면을 채움. 나머지는 꽉 찬 상태로 잠깐 머무름
      const p = stickyProgress(hero);
      const e = easeInOut(clamp01(p / 0.65));

      const r = lerp(r0, r1, e);
      const cy = lerp(cy0, vh / 2, e);
      media.style.clipPath = `circle(${r}px at 50% ${cy}px)`;
      video.style.transform = `scale(${1.15 - 0.15 * e})`;
      shade.style.opacity = String(e);

      // 원이 제목까지 올라오면 글씨를 검정 → 흰색으로
      const w = clamp01((e - 0.3) / 0.35);
      const v = Math.round(lerp(10, 255, w));
      copy.style.color = `rgb(${v}, ${v}, ${v})`;

      // 화면이 다 차면 아래 설명이 나타남
      const s = easeOut(clamp01((p - 0.6) / 0.2));
      sub.style.opacity = String(s);
      sub.style.transform = `translateY(${(1 - s) * 16}px)`;

      // 원이 헤더 왼쪽 로고 자리까지 덮으면 헤더 글자를 흰색으로
      if (header) header.dataset.tone = Math.hypot(vw / 2 - vw * 0.06, cy - 32) < r ? 'dark' : 'light';
    };

    onScrollFrame(render, measure);
  }
</script>
