---
import { site } from '../../../data/site';
---

<!--
  스크롤 히어로
  - 처음: 흰 배경 + 큰 제목 + 둥근 박스 안의 영상
  - 스크롤: 박스가 커지며 영상이 화면을 꽉 채움 → 영상 위 문구가 한 줄씩 올라옴
  - '움직임 줄이기' 설정 사용자나 JS가 꺼진 환경에선 처음부터 꽉 찬 영상으로 보임
-->
<section id="hero" data-hero class="hero relative bg-ink">
  <div class="hero-stage sticky top-0 h-svh min-h-[560px] overflow-hidden">
    <div class="hero-media absolute inset-0 overflow-hidden bg-ink">
      <video
        class="hero-video absolute inset-0 h-full w-full object-cover"
        src={site.hero.video}
        poster={site.hero.poster}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      <div class="hero-shade absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-black/75"></div>
    </div>

    <div class="hero-intro absolute inset-x-0 top-0">
      <div class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 sm:pt-28 lg:px-8 lg:pt-36">
        <p class="hero-rise text-sm font-semibold tracking-[0.3em] text-accent" style="--d: 0ms">
          <span>CLOTHING MANUFACTURER</span>
        </p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.15] sm:text-6xl lg:text-7xl">
          <span class="hero-rise" style="--d: 120ms"><span>생각한 그대로,</span></span>
          <span class="hero-rise" style="--d: 240ms"><span>입을 수 있는 옷으로.</span></span>
        </h1>
      </div>
    </div>

    <div class="hero-overlay absolute inset-0 flex items-end text-white">
      <div class="mx-auto w-full max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-28">
        <p class="hero-line text-sm font-semibold tracking-[0.3em] text-accent">FROM SKETCH TO DELIVERY</p>
        <p class="hero-line mt-4 text-3xl font-bold leading-tight sm:text-5xl lg:text-6xl">
          기획부터 납품까지,<br />한 곳에서.
        </p>
        <p class="hero-line mt-6 max-w-lg text-base text-white/80 sm:text-lg">
          단체복부터 브랜드 OEM까지. 기획, 샘플, 생산, 납품을 {site.name}이 한 번에 맡습니다.
        </p>
        <div class="hero-line mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="rounded-full bg-accent px-8 py-4 text-center font-semibold transition-colors hover:bg-accent-dark">
            견적 문의하기
          </a>
          <a
            href="/portfolio"
            class="rounded-full border border-white/40 px-8 py-4 text-center font-semibold transition-colors hover:bg-white hover:text-ink"
          >
            포트폴리오 보기
          </a>
        </div>
      </div>
    </div>

    <div class="hero-cue pointer-events-none absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-white" aria-hidden="true">
      <span class="text-[11px] tracking-[0.3em] text-white/80">SCROLL</span>
      <span class="hero-cue-line block h-10 w-px bg-white/30"></span>
    </div>
  </div>
</section>

<style is:global>
  /* 기본(움직임 없음): 꽉 찬 영상 위에 흰 글씨 */
  .hero-intro { color: #fff; }

  /* 움직임 모드: Layout의 head 스크립트가 <html>에 .motion 을 붙임 */
  .motion .hero { height: 280vh; background: var(--color-paper); }
  .motion .hero-intro { color: var(--color-ink); will-change: transform, opacity; }
  .motion .hero-media {
    /* JS가 정확한 값으로 바로 덮어씀. 아래는 첫 그림이 튀지 않게 하는 대략값 */
    clip-path: inset(46% 16px 16px 16px round 24px);
    will-change: clip-path;
  }
  .motion .hero-video { transform: scale(1.15); will-change: transform; }
  .motion .hero-shade { opacity: 0; }
  .motion .hero-overlay { visibility: hidden; }
  .motion .hero-line { opacity: 0; transform: translateY(40px); will-change: transform, opacity; }

  /* 처음 들어왔을 때 제목이 아래에서 올라오는 효과 */
  .motion .hero-rise { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .motion .hero-rise > span {
    display: block;
    animation: hero-rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) both;
  }
  .hero h1 .hero-rise { display: block; }

  @keyframes hero-rise {
    from { transform: translateY(110%); }
    to { transform: translateY(0); }
  }

  /* SCROLL 아래 선이 흘러내리는 효과 */
  .hero-cue-line { position: relative; overflow: hidden; }
  .motion .hero-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    animation: hero-cue 1.8s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  @keyframes hero-cue {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero && document.documentElement.classList.contains('motion')) {
    const stage = hero.querySelector<HTMLElement>('.hero-stage')!;
    const media = hero.querySelector<HTMLElement>('.hero-media')!;
    const video = hero.querySelector<HTMLElement>('.hero-video')!;
    const shade = hero.querySelector<HTMLElement>('.hero-shade')!;
    const intro = hero.querySelector<HTMLElement>('.hero-intro')!;
    const title = intro.querySelector<HTMLElement>('h1')!;
    const overlay = hero.querySelector<HTMLElement>('.hero-overlay')!;
    const lines = [...hero.querySelectorAll<HTMLElement>('.hero-line')];
    const cue = hero.querySelector<HTMLElement>('.hero-cue')!;
    const header = document.getElementById('site-header');

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    // 박스의 처음 위치(px). 화면 크기가 바뀔 때마다 다시 잼
    let top = 0;
    let side = 0;
    let bottom = 0;
    let radius = 24;

    const measure = () => {
      const vw = window.innerWidth;
      const vh = stage.offsetHeight;
      const pad = vw >= 1024 ? 32 : vw >= 640 ? 24 : 16;
      // 박스 좌우 끝을 본문 컨테이너(max-w-7xl)에 맞춤
      side = Math.max(pad, (vw - 1280) / 2 + pad);
      bottom = pad;
      radius = vw >= 640 ? 24 : 16;
      // 제목 바로 아래에서 박스가 시작. 박스가 너무 작아지지 않게 화면의 60%에서 멈춤
      const gap = vw >= 640 ? 48 : 32;
      top = Math.min(title.offsetTop + title.offsetHeight + gap, vh * 0.6);
    };

    const render = () => {
      const range = hero.offsetHeight - stage.offsetHeight;
      const p = range > 0 ? clamp(-hero.getBoundingClientRect().top / range) : 1;

      // 0 ~ 55%: 박스가 커져 화면을 채움
      const e = easeInOut(clamp(p / 0.55));
      const k = 1 - e;
      media.style.clipPath = `inset(${top * k}px ${side * k}px ${bottom * k}px ${side * k}px round ${radius * k}px)`;
      video.style.transform = `scale(${1.15 - 0.15 * e})`;
      shade.style.opacity = String(e);

      // 0 ~ 30%: 제목이 위로 빠지며 사라짐
      const ip = easeOut(clamp(p / 0.3));
      intro.style.opacity = String(1 - ip);
      intro.style.transform = `translateY(${-80 * ip}px)`;
      cue.style.opacity = String(1 - clamp(p / 0.12));

      // 50% 이후: 영상 위 문구가 한 줄씩 올라옴
      overlay.style.visibility = p > 0.45 ? 'visible' : 'hidden';
      lines.forEach((el, i) => {
        const t = easeOut(clamp((p - 0.5 - i * 0.07) / 0.2));
        el.style.opacity = String(t);
        el.style.transform = `translateY(${(1 - t) * 40}px)`;
      });

      // 영상이 헤더 뒤까지 차면 헤더 글자를 흰색으로
      if (header) header.dataset.tone = e > 0.9 ? 'dark' : 'light';
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        render();
      });
    };

    measure();
    render();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      onScroll();
    });
    // 웹폰트가 늦게 로드되면 제목 높이가 바뀌므로 다시 잼
    document.fonts?.ready.then(() => {
      measure();
      render();
    });
  }
</script>
