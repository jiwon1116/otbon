---
import { partners } from '../../../data/site';
---

<!-- 함께한 업체: 얇은 선으로 나뉜 로고 칸이 옆으로 흐름 -->
<section class="overflow-hidden bg-paper pt-28 lg:pt-36" data-partners>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-reveal>
    <p class="text-xs font-medium tracking-[0.25em] text-muted sm:text-sm">PARTNERS</p>
    <h2 class="mt-6 text-3xl font-semibold leading-snug tracking-tight sm:text-4xl">함께한 브랜드</h2>
  </div>

  <div class="drift-wrap mt-14 lg:mt-16">
    <ul class="drift-row" data-drift="left">
      {partners.map((p) => (
        <li class="partner-cell flex aspect-[3/2] w-[56vw] shrink-0 items-center justify-center p-10 sm:w-[34vw] lg:w-[24vw] lg:max-w-[360px]">
          {p.logo ? (
            <img src={p.logo} alt={p.name} loading="lazy" class="max-h-14 w-auto max-w-[65%] object-contain opacity-80" />
          ) : (
            <span class="text-sm text-muted">{p.name || '로고 준비 중'}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partner-cell { border-left: 1px solid rgb(40 40 40 / 0.12); }
  .partner-cell:last-child { border-right: 1px solid rgb(40 40 40 / 0.12); }
</style>

<script>
  import { initDrift } from '../../../scripts/drift';
  initDrift(document.querySelector<HTMLElement>('[data-partners]'));
</script>
