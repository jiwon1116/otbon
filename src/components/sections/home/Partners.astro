---
import { partners } from '../../../data/site';

// 로고 면적을 맞춰서 너비를 정함 (가로로 긴 로고 · 뭉툭한 로고가 비슷한 무게로 보이게)
const logoWidth = (ratio = 4) => Math.round(Math.sqrt(5200 * ratio));
---

<!--
  함께한 브랜드: 크림색 둥근 카드에 로고를 하나씩 (PC 4칸 · 휴대폰 2칸). 문구 · 로고는 src/data/site.ts 의 partners
  - 화면에 들어오면 카드가 순서대로 아래에서 떠오름 (data-reveal)
  - 마우스를 올리면 카드가 살짝 뜨고 로고가 진해짐
  - 마지막 초록 칸은 견적 문의로 가는 버튼
-->
<section class="bg-paper py-24 lg:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">Partners</p>
      <h2 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">함께한 브랜드</h2>
      <p class="mt-4 text-muted">옷본과 함께 옷을 만든 브랜드입니다.</p>
    </div>

    <ul class="mt-14 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-16 lg:grid-cols-4">
      {partners.map((p, i) => (
        <li class="pt-card" data-reveal style={`--reveal-delay: ${(i % 4) * 80}ms`}>
          {p.logo
            ? <img src={p.logo} alt={p.name} loading="lazy" style={`width:${logoWidth(p.ratio)}px`} />
            : <span class="pt-word">{p.name}</span>}
        </li>
      ))}
      <li data-reveal style={`--reveal-delay: ${(partners.length % 4) * 80}ms`}>
        <a href="/#contact" class="pt-card pt-cta">
          <span class="text-sm font-semibold sm:text-base">다음은 당신의 브랜드</span>
          <span class="pt-cta-sub">제작 문의하기 <span class="pt-cta-arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .pt-card {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    aspect-ratio: 16 / 10; border-radius: 24px; background: #faf6ee;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.45s;
  }
  .pt-card:hover { transform: translateY(-4px); box-shadow: 0 18px 34px -22px rgb(40 40 40 / 0.4); }
  /* 로고는 배경에 섞이게 (JPG 흰 바탕도 안 보이게), 평소엔 살짝 옅게 */
  .pt-card img { max-width: 72%; height: auto; mix-blend-mode: multiply; opacity: 0.82; transition: opacity 0.3s; }
  .pt-word { font-size: clamp(15px, 1.8vw, 20px); font-weight: 500; letter-spacing: 0.14em; opacity: 0.82; transition: opacity 0.3s; }
  .pt-card:hover :is(img, .pt-word) { opacity: 1; }

  .pt-cta { height: 100%; aspect-ratio: auto; background: var(--color-accent); color: #f5f1e8; }
  .pt-cta:hover { background: var(--color-accent-dark); }
  .pt-cta-sub { font-size: 12px; opacity: 0.75; }
  .pt-cta-arrow { display: inline-block; transition: transform 0.3s; }
  .pt-cta:hover .pt-cta-arrow { transform: translateX(3px); }
</style>
