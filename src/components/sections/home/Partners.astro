---
import PartnersStack from './PartnersStack';
import { partners } from '../../../data/site';

// 사진: public/images/partners/cards/브랜드이름.jpg (900×1200)
//   브랜드 이름을 소문자로, 띄어쓰기는 - 로 (예: '999 HUMANITY' → 999-humanity.jpg)
const items = partners.map((p, i) => ({
  image: `/images/partners/cards/${p.name.toLowerCase().replace(/\s+/g, '-')}.jpg`,
  name: p.name,
  num: String(i + 1).padStart(2, '0'),
}));
---

<!--
  함께한 브랜드: 겹쳐 쌓인 사진 카드 (componentry 의 layered-stack, React · gsap)
  - 메인 지도처럼 이 섹션을 지나가는 동안 화면이 고정됨 (data-pin)
  - 처음엔 브랜드 사진 카드가 가운데 삐뚤빼뚤 쌓여 있다가, 스크롤하면 차례로 격자 자리로 펼쳐짐
  - 제목과 카드 7장이 한 화면에 다 들어오게 카드 크기를 화면 높이에 맞춤
  - 카드 아래 크림색 띠에 브랜드 이름 · 번호
  브랜드 목록은 src/data/site.ts 의 partners, 사진은 public/images/partners/cards/
-->
<section class="pt-pin bg-paper" data-pin>
  <div class="pt-stage">
    <div class="px-4 text-center sm:px-6 lg:px-8" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">Partners</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">함께한 브랜드</h2>
    </div>
    <div class="pt-cards-wrap px-4 sm:px-6 lg:px-8">
      <PartnersStack client:load items={items} />
    </div>
  </div>
</section>

<style is:global>
  /* 지도처럼: 긴 섹션 안에서 화면(높이 100%)이 고정되고, 스크롤하는 동안 카드가 펼쳐짐 */
  .pt-pin { height: 240svh; margin-top: 96px; margin-bottom: 120px; } /* 아래 여백: 견적 문의와 간격 */
  @media (min-width: 1024px) { .pt-pin { margin-top: 144px; margin-bottom: 200px; } }
  .pt-stage { position: sticky; top: 0; height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 28px; padding-top: 72px; padding-bottom: 24px; }
  @media (min-width: 1024px) { .pt-stage { padding-top: 88px; gap: 36px; } }

  /* 카드 크기: 두 줄(PC 4칸) · 세 줄(휴대폰 3칸)이 남은 화면 높이에 딱 들어가게
     --avail = 화면 높이 - 위 메뉴 · 제목 · 여백, --cap = 카드 아래 이름 띠 + 테두리 높이 */
  .pt-grid-cards { --cols: 4; --rows: 2; --gap: 16px; --cap: 46px; --avail: calc(100svh - 300px);
    --w: min(calc((100vw - 64px - (var(--cols) - 1) * var(--gap)) / var(--cols)), calc(((var(--avail) - (var(--rows) - 1) * var(--gap)) / var(--rows) - var(--cap)) * 0.75), 230px);
    display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap);
    max-width: calc(var(--cols) * var(--w) + (var(--cols) - 1) * var(--gap)); } /* 남는 칸은 마지막 줄 가운데로 */
  @media (max-width: 639px) { .pt-grid-cards { --cols: 3; --rows: 3; --gap: 8px; --cap: 30px; --avail: calc(100svh - 230px); } }
  .pt-grid-cards > figure { width: var(--w); }
</style>
