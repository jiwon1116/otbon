---
import { site, partners } from '../../../data/site';
---

<!-- 함께한 업체: 로고 카드가 옆으로 흐름 -->
<section class="overflow-hidden bg-soft py-24 lg:py-32" data-partners>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-reveal>
    <h2 class="text-2xl font-bold sm:text-4xl">{site.nameKo}과 함께한 업체</h2>
  </div>

  <div class="drift-wrap mt-12 lg:mt-16">
    <ul class="drift-row gap-4 sm:gap-6" data-drift="left">
      {partners.map((p) => (
        <li class="flex aspect-[4/3] w-[64vw] shrink-0 items-center justify-center rounded-2xl bg-paper p-10 sm:w-[40vw] lg:w-[30vw] lg:max-w-[460px]">
          {p.logo ? (
            <img src={p.logo} alt={p.name} loading="lazy" class="max-h-20 w-auto max-w-[70%] object-contain" />
          ) : (
            <span class="text-sm text-muted">{p.name || '로고 준비 중'}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { initDrift } from '../../../scripts/drift';
  initDrift(document.querySelector<HTMLElement>('[data-partners]'));
</script>
