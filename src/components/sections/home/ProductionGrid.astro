---
import { Image } from 'astro:assets';
import { site, services } from '../../../data/site';
import { photo } from '../../../data/photos';
---

<!-- 생산 분야: 사진 카드 2x2 -->
<section id="production" class="scroll-mt-20 bg-paper">
  <div class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-36">
    <div data-reveal>
      <h2 class="text-2xl font-bold sm:text-4xl">{site.nameKo}은 이런 생산을 하고 있어요</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">
        티셔츠 몇십 장부터 브랜드 시즌 생산까지. 필요한 수량과 일정에 맞춰, 원단 선택부터 납품까지 한 번에 진행합니다.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:mt-16">
      {services.map((s, i) => (
        <article
          class="group relative aspect-[4/3] overflow-hidden rounded-2xl bg-ink text-white sm:aspect-[16/11]"
          data-reveal
          style={`--reveal-delay: ${(i % 2) * 120}ms`}
        >
          <Image
            src={photo(s.photo)}
            alt=""
            widths={[640, 960, 1400]}
            sizes="(min-width: 640px) 50vw, 100vw"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/45"></div>
          <div class="relative flex h-full flex-col justify-between p-6 sm:p-8 lg:p-10">
            <span class="text-xs font-semibold tracking-[0.2em] text-white/70">0{i + 1} · {s.en.toUpperCase()}</span>
            <div>
              <h3 class="text-2xl font-bold sm:text-3xl lg:text-4xl">{s.title}</h3>
              <p class="mt-3 max-w-md text-sm leading-relaxed text-white/80 sm:text-base">{s.desc}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
