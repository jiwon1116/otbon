---
import { services, servicesIntro } from '../../../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
// hideHead: 생산 분야 페이지처럼 위에 따로 큰 제목이 있을 때 이 섹션 제목줄을 숨김
const { hideHead = false } = Astro.props as { hideHead?: boolean };

---

<!--
  생산 분야: 제목 + 번호 카드 6장 (큰 화면 3칸 × 2줄, 태블릿 2칸, 휴대폰 1칸)
  - 사진은 빼고 글 중심으로. 카드마다 굵은 초록 번호 · 제목 · 영어 이름 · 설명
  - 마우스를 올리면 카드가 살짝 떠오름
-->
<section id="production" class="scroll-mt-20 bg-paper">
  <div class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    {!hideHead && <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-xs font-medium tracking-[0.25em] text-muted sm:text-sm">{servicesIntro.eyebrow}</p>
      <h2 class="mt-6 text-3xl font-semibold leading-snug tracking-tight sm:text-4xl">{servicesIntro.title}</h2>
      <p class="mt-5 leading-relaxed text-muted">{servicesIntro.desc}</p>
    </div>}

    <ul class:list={["mx-auto grid max-w-6xl gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-4", !hideHead && "mt-10 lg:mt-12"]}>
      {services.map((s, i) => (
        <li data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
          <article class="cap-card">
            <span class="block text-2xl font-bold leading-none tracking-tight text-accent tabular-nums lg:text-3xl">{pad(i + 1)}</span>
            <h3 class="mt-4 text-lg font-semibold tracking-tight lg:text-xl">{s.title}</h3>
            <p class="mt-1 text-[10px] uppercase tracking-[0.2em] text-muted lg:text-[11px]">{s.en}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.desc}</p>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* 카드: 바탕보다 밝은 따뜻한 흰색 + 얇은 테두리, 마우스를 올리면 살짝 떠오름 */
  .cap-card {
    height: 100%;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: #fdfbf7;
    box-shadow: 0 1px 2px rgb(40 40 40 / 0.04);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s ease;
  }
  @media (min-width: 1024px) { .cap-card { padding: 1.5rem 1.75rem; } }
  .cap-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px -16px rgb(40 40 40 / 0.18); }


  @media (prefers-reduced-motion: reduce) {
    .cap-card { transition: none; }
    .cap-card:hover { transform: none; }
  }
</style>
