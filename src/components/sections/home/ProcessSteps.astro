---
import { Image } from 'astro:assets';
import { process, processIntro } from '../../../data/site';
import { photo } from '../../../data/photos';

// more: 메인 화면에서 '제작 기준' 페이지로 가는 링크를 설명 아래에 붙일 때
const { more } = Astro.props as { more?: { href: string; label: string } };
---

<!--
  제작 과정: 위에 제목과 설명, 아래 4단계를 네 칸으로 (태블릿 2칸)
  - 휴대폰: 번호 + 제목 줄만 보이는 접는 목록. 줄을 누르면 사진과 설명이 펼쳐짐 (처음엔 01만 열림)
  - 칸마다: 번호 + 얇은 선 → 사진 → 제목 → 설명
  - 화면에 들어오면 칸이 차례로 살짝 떠오름. 마우스를 올리면 선이 초록으로, 사진이 아주 살짝 커짐
-->
<section id="process" class="scroll-mt-20 bg-paper">
  <div class="mx-auto max-w-7xl px-4 pb-28 sm:px-6 lg:px-8 lg:pb-40">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-8" data-reveal>
      <div class="lg:col-span-7">
        <p class="text-xs font-medium tracking-[0.25em] text-muted sm:text-sm">PROCESS</p>
        <h2 class="mt-6 text-3xl font-semibold leading-snug tracking-tight sm:text-4xl">{processIntro.title}</h2>
      </div>
      <div class="max-w-sm lg:col-span-4 lg:col-start-9">
        <p class="leading-relaxed text-muted">{processIntro.desc}</p>
        {more && <a href={more.href} class="more-link mt-5">{more.label}<span aria-hidden="true">→</span></a>}
      </div>
    </div>

    <ol class="mt-12 grid gap-x-6 gap-y-8 sm:mt-16 sm:gap-y-14 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-x-8">
      {process.map((p, i) => (
        <li class:list={["step", i === 0 && "is-on"]} data-step-item data-reveal style={`--reveal-delay: ${i * 110}ms`}>
          <div class="step-head flex items-center gap-4 text-sm tabular-nums">
            <span class="font-medium text-ink">{p.step}</span>
            <span class="step-rule h-px flex-1" aria-hidden="true"></span>
            <span class="text-[11px] uppercase tracking-[0.2em] text-muted">{p.en}</span>
          </div>
          <div class="step-photo mt-6">
            <Image
              src={photo(p.photo)}
              alt={`${p.title} 과정 현장 사진`}
              widths={[400, 640, 900]}
              sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 92vw"
              class="h-full w-full object-cover"
            />
          </div>
          <h3 class="step-title mt-6 text-xl font-semibold tracking-tight">{p.title}</h3>
          <p class="step-desc mt-3 text-[15px] leading-relaxed text-muted">{p.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  /* 자세히 보기 링크 (메인 화면 요약 섹션 공통) */
  .more-link { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 999px; background: var(--color-accent); color: #f5f1e8; font-size: 14px; font-weight: 600; transition: background-color 0.25s ease; }
  .more-link span { transition: transform 0.25s ease; }
  .more-link:hover { background: var(--color-accent-dark); }
  .more-link:hover span { transform: translateX(3px); }

  .step-rule { background: rgb(40 40 40 / 0.2); transition: background-color 0.4s ease; }
  .step:hover .step-rule { background: var(--color-accent); }

  .step-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-soft);
  }
  /* 휴대폰: 접는 목록 */
  @media (max-width: 639px) {
    #process ol { gap: 0; }
    .step { display: grid; grid-template-columns: 2.25rem 1fr 1rem; grid-template-areas: 'head title arrow' '. photo photo' '. desc desc'; align-items: center; padding: 1.1rem 0; border-top: 1px solid var(--color-line); cursor: pointer; }
    .step:last-child { border-bottom: 1px solid var(--color-line); }
    .step-head { grid-area: head; }
    .step-head .step-rule, .step-head span:last-child { display: none; }
    .step-title { grid-area: title; margin: 0; font-size: 1.05rem; }
    .step::after { content: ''; grid-area: arrow; justify-self: center; width: 0.5rem; height: 0.5rem; border-right: 1.5px solid var(--color-muted); border-bottom: 1.5px solid var(--color-muted); transform: rotate(45deg); transition: transform 0.3s ease; }
    .step.is-on::after { transform: rotate(-135deg); }
    .step-photo { grid-area: photo; display: none; margin-top: 1rem; aspect-ratio: 16 / 10; border-radius: 12px; }
    .step-desc { grid-area: desc; display: none; margin-top: 0.75rem; font-size: 0.875rem; }
    .step.is-on :is(.step-photo, .step-desc) { display: block; animation: reveal-up 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  }

  .step-photo img { transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .step:hover .step-photo img { transform: scale(1.03); }
</style>

<script>
  // 휴대폰 접는 목록: 누른 단계만 펼치고, 열린 걸 다시 누르면 접힘
  const items = [...document.querySelectorAll<HTMLElement>('#process [data-step-item]')];
  items.forEach((li) =>
    li.addEventListener('click', () => {
      if (window.innerWidth >= 640) return;
      const open = li.classList.contains('is-on');
      items.forEach((x) => x.classList.remove('is-on'));
      if (!open) li.classList.add('is-on');
    }),
  );
</script>
