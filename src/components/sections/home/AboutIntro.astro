---
import { about } from '../../../data/site';

// '**굵게**' 표시를 잘라서 [보통, 굵게, 보통...] 조각으로 만듦
const toParts = (line: string) => line.split('**').map((text, i) => ({ text, bold: i % 2 === 1 }));
---

<!-- 회사 소개: 큰 문장 + 오른쪽 설명 -->
<section id="about" class="scroll-mt-20 bg-paper">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-36">
    <p class="text-xs font-semibold tracking-[0.25em] text-muted sm:text-sm" data-reveal>{about.eyebrow}</p>

    <h2 class="mt-6 text-2xl font-medium leading-snug text-ink/80 sm:text-4xl sm:leading-snug lg:text-5xl lg:leading-[1.3]">
      {about.headline.map((line, i) => (
        <span class="block" data-reveal style={`--reveal-delay: ${100 + i * 120}ms`}>
          {toParts(line).map((part) => (part.bold ? <strong class="font-bold text-ink">{part.text}</strong> : part.text))}
        </span>
      ))}
    </h2>

    <div class="mt-16 grid lg:mt-24 lg:grid-cols-12">
      <div class="space-y-5 leading-relaxed text-muted lg:col-span-5 lg:col-start-8">
        <span class="block h-1 w-10 bg-ink" data-reveal aria-hidden="true"></span>
        {about.body.map((para, i) => (
          <p data-reveal style={`--reveal-delay: ${120 + i * 120}ms`}>{para}</p>
        ))}
      </div>
    </div>
  </div>
</section>
