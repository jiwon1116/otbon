---
import { about } from '../../../data/site';

// '**강조**' 표시를 잘라서 [보통, 강조, 보통...] 조각으로, 조각은 다시 단어로 나눔
const toParts = (line: string) =>
  line.split('**').map((text, i) => ({ strong: i % 2 === 1, words: text.split(/(\s+)/).filter(Boolean) }));
// 설명 문단에선 '**' 표시만 지움 (다른 글자와 똑같이 보임)
const plain = (para: string) => para.replaceAll('**', '');
---

<!--
  회사 소개: 큰 문장 + 오른쪽 설명
  - 스크롤하면 제목이 단어 단위로 연한 색 → 진한 색으로 채워짐 (이 사이트의 대표 효과)
  - 설명 문단은 위의 얇은 선과 함께 살짝 떠오름
  - '동작 줄이기' 사용자나 JS가 꺼진 환경에선 처음부터 다 채워진 상태
-->
<section id="about" class="scroll-mt-20 bg-paper" data-about>
  <div class="mx-auto max-w-7xl px-4 py-28 sm:px-6 lg:px-8 lg:py-40">
    <p class="text-xs font-medium tracking-[0.25em] text-muted sm:text-sm" data-reveal>{about.eyebrow}</p>

    <h2 class="about-title mt-8 text-2xl font-normal leading-snug tracking-tight sm:text-4xl sm:leading-snug lg:text-5xl lg:leading-[1.35]">
      {about.headline.map((line) => (
        <span class="block">
          {toParts(line).map((part) =>
            part.strong ? (
              <strong class="font-semibold">
                {part.words.map((w) => (/^\s+$/.test(w) ? w : <span class:list={['about-word is-strong', w === 'OTBON' && 'about-brand']}>{w}</span>))}
              </strong>
            ) : (
              part.words.map((w) => (/^\s+$/.test(w) ? w : <span class="about-word">{w}</span>))
            ),
          )}
        </span>
      ))}
    </h2>

    <div class="mt-20 grid lg:mt-28 lg:grid-cols-12">
      <div class="space-y-5 border-t border-ink/15 pt-8 leading-relaxed text-muted lg:col-span-5 lg:col-start-8" data-reveal style="--reveal-delay: 150ms">
        {about.body.map((para) => <p>{plain(para)}</p>)}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .about-word { color: rgb(40 40 40 / 0.75); transition: color 0.35s ease; }
  .about-word.is-strong { color: var(--color-ink); }
  /* 'OTBON' 글자만 1.3배 크게 */
  .about-brand { font-size: 1.1em; margin-right: 0.1em; }

  /* 움직임 모드 */
  .motion .about-word { color: rgb(40 40 40 / 0.14); }
  .motion .about-word.is-lit { color: rgb(40 40 40 / 0.75); }
  .motion .about-word.is-strong.is-lit { color: var(--color-ink); }
</style>

<script>
  import { onScrollFrame, motionOn, clamp01 } from '../../../scripts/scroll';

  const section = document.querySelector<HTMLElement>('[data-about]');

  if (section && motionOn()) {
    const title = section.querySelector<HTMLElement>('.about-title')!;
    const words = [...title.querySelectorAll<HTMLElement>('.about-word')];

    onScrollFrame(() => {
      // 제목 윗변이 화면 85% 지점에 닿으면 시작, 화면 35% 지점까지 올라오면 다 채워짐
      const vh = window.innerHeight;
      const top = title.getBoundingClientRect().top;
      const lit = clamp01((vh * 0.85 - top) / (vh * 0.5)) * words.length;
      words.forEach((w, i) => w.classList.toggle('is-lit', i < lit));
    });
  }
</script>
