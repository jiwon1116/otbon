---
import { Image } from 'astro:assets';
import { gallery } from '../../../data/site';
import { photo } from '../../../data/photos';
---

<!-- 제작현황: 현장 사진 두 줄이 스크롤에 맞춰 서로 반대로 흐름 -->
<section id="works" class="scroll-mt-20 overflow-hidden bg-paper pb-24 lg:pb-36" aria-label="제작 현장 사진" data-gallery>
  <!-- 사진이 화면을 꽉 채우지 않도록 카드 크기를 작게 (한 화면에 4~5장 보임) -->
  <div class="flex flex-col gap-3 sm:gap-4">
    {gallery.map((row, r) => (
      <div class="drift-wrap">
        <ul class="drift-row gap-3 sm:gap-4" data-drift={r === 0 ? 'left' : 'right'}>
          {row.map((item) => (
            <li class="w-[52vw] shrink-0 sm:w-[32vw] lg:w-[21vw] lg:max-w-[320px]">
              <div class="aspect-[4/3] overflow-hidden rounded-xl bg-soft">
                <Image
                  src={photo(item.photo)}
                  alt={item.alt}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 1024px) 21vw, (min-width: 640px) 32vw, 52vw"
                  class="h-full w-full object-cover"
                />
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<script>
  import { initDrift } from '../../../scripts/drift';
  initDrift(document.querySelector<HTMLElement>('[data-gallery]'));
</script>
