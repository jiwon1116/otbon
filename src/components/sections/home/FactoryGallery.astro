---
import { Image } from 'astro:assets';
import { gallery } from '../../../data/site';
import { photo } from '../../../data/photos';
---

<!-- 제작현황: 현장 사진 두 줄이 스크롤에 맞춰 서로 반대로 흐름 -->
<section id="works" class="scroll-mt-20 overflow-hidden bg-paper pb-24 lg:pb-36" aria-label="제작 현장 사진" data-gallery>
  <div class="flex flex-col gap-4 sm:gap-6">
    {gallery.map((row, r) => (
      <div class="drift-wrap">
        <ul class="drift-row gap-4 sm:gap-6" data-drift={r === 0 ? 'left' : 'right'}>
          {row.map((item) => (
            <li class="w-[72vw] shrink-0 sm:w-[44vw] lg:w-[30vw] lg:max-w-[480px]">
              <div class="aspect-[4/3] overflow-hidden rounded-xl bg-soft">
                <Image
                  src={photo(item.photo)}
                  alt={item.alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 44vw, 72vw"
                  class="h-full w-full object-cover"
                />
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<script>
  import { initDrift } from '../../../scripts/drift';
  initDrift(document.querySelector<HTMLElement>('[data-gallery]'));
</script>
