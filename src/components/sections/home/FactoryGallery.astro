---
import { Image } from 'astro:assets';
import { gallery } from '../../../data/site';
import { sitePhoto } from '../../../data/photos';
---

<!--
  제작현황: 현장 사진 두 줄이 저절로 서로 반대 방향으로 계속 흐름
  - 사진 목록을 두 번 이어 붙여서 끊김 없이 돌아감 (두 번째 묶음은 화면 읽기 프로그램에서 숨김)
  - 사진에 마우스를 올리면 두 줄 모두 멈추고, 그 사진 아래에 공장 이름이 나옴
  - 마우스(또는 손가락)로 잡고 옆으로 끌면 그 줄이 따라 움직이고, 놓으면 다시 저절로 흐름
  - '동작 줄이기' 사용자나 JS가 꺼진 환경에선 멈춰 있고 손가락/트랙패드로 넘겨서 봄
-->
<section id="works" class="scroll-mt-20 overflow-hidden bg-paper pb-24 lg:pb-36" aria-label="제작 현장 사진">
  <div class="marquee-rows flex flex-col gap-3 sm:gap-4">
    {gallery.map((row, r) => (
      <div class="marquee-wrap">
        <ul class:list={['marquee-row', r === 1 && 'is-reverse']}>
          {[0, 1].map((copy) =>
            row.map((item) => (
              <li class="marquee-item" aria-hidden={copy === 1 ? 'true' : undefined}>
                <figure class="gallery-card">
                  <Image
                    src={sitePhoto(item.site)}
                    alt={copy === 1 ? '' : `${item.factory} 현장`}
                    widths={[400, 640, 960]}
                    sizes="(min-width: 1024px) 21vw, (min-width: 640px) 32vw, 52vw"
                    class="h-full w-full object-cover"
                  />
                  <figcaption class="gallery-cap">
                    <span class="font-semibold">{item.factory}</span>
                  </figcaption>
                </figure>
              </li>
            )),
          )}
        </ul>
      </div>
    ))}
  </div>

  <!-- 끌 수 있다는 표시: 마우스 화면에선 사진 위에서 커서를 따라다니는 초록 동그라미, 터치 화면에선 아래 안내 문구 -->
  <div class="drag-cursor" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4L2 8l4 4" /></svg>
    <span>DRAG</span>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4l4 4-4 4" /></svg>
  </div>
  <p class="drag-hint" aria-hidden="true">← 옆으로 밀어서 둘러보세요 →</p>
</section>

<style is:global>
  /* 기본(움직임 없음): 옆으로 넘겨서 봄, 이어 붙인 두 번째 묶음은 숨김 */
  .marquee-wrap { overflow-x: auto; scrollbar-width: none; }
  .marquee-wrap::-webkit-scrollbar { display: none; }
  .marquee-row { display: flex; width: max-content; padding-left: 1rem; }
  .marquee-item { width: 52vw; flex-shrink: 0; margin-right: 0.75rem; }
  .marquee-item[aria-hidden='true'] { display: none; }
  @media (min-width: 640px) {
    .marquee-item { width: 32vw; margin-right: 1rem; }
  }
  @media (min-width: 1024px) {
    .marquee-item { width: 21vw; max-width: 320px; }
  }

  /* 움직임 모드: 저절로 흐름. 사진 묶음 하나 길이(-50%)만큼 움직이면 처음과 똑같은 모습이라 끊김이 없음 */
  .motion .marquee-wrap { overflow: visible; }
  .motion .marquee-row { padding-left: 0; animation: marquee 130s linear infinite; /* 사진이 늘어난 만큼 길게 (한 줄 16장) */ }
  .motion .marquee-row.is-reverse { animation-direction: reverse; }
  .motion .marquee-item[aria-hidden='true'] { display: block; }
  /* 사진 하나에 마우스를 올리면 두 줄 모두 멈춤 */
  .motion .marquee-rows:has(.gallery-card:hover) .marquee-row { animation-play-state: paused; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* 사진 카드 */
  .gallery-card {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-soft);
    transition: opacity 0.4s ease;
  }
  .gallery-card img { transition: transform 0.6s ease; }

  /* 마우스를 올리면: 사진이 살짝 어두워지고, 왼쪽 아래에 공장 이름이 짧은 선과 함께 떠오름 */
  .gallery-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0) 55%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .gallery-cap {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.9rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: #fff;
    font-size: 0.95rem;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* 이름 위 짧은 선: 왼쪽부터 그어짐 */
  .gallery-cap::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    margin-bottom: 0.35rem;
    background: rgb(255 255 255 / 0.8);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s;
  }

  .gallery-card:hover img { transform: scale(1.03); }
  .gallery-card:hover::after { opacity: 1; }
  .gallery-card:hover .gallery-cap { opacity: 1; transform: none; }

  /* 한 장에 마우스를 올리면 두 줄의 다른 사진이 모두 살짝 어두워져서 그 사진만 돋보임 */
  .gallery-card img { transition: transform 0.6s ease, filter 0.4s ease; }
  .marquee-rows:has(.gallery-card:hover) .gallery-card:not(:hover) img { filter: brightness(0.6); }

  /* 끌기 모드(JS 동작 중): CSS 흐름 대신 JS가 위치를 움직임. 세로 스크롤은 그대로 되고 가로로만 끌림 */
  .motion .marquee-rows.is-js .marquee-row { animation: none; cursor: grab; touch-action: pan-y; user-select: none; will-change: transform; }
  .motion .marquee-rows.is-js .marquee-row.is-dragging { cursor: grabbing; }
  .marquee-rows.is-js img { -webkit-user-drag: none; pointer-events: none; }
  .gallery-card:hover .gallery-cap::before { transform: none; }

  /* 끌기 표시 (마우스): 사진 줄 위에서는 기본 커서 대신 초록 동그라미가 따라다님. 잡으면 살짝 작아짐 */
  .drag-cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: 5rem;
    height: 5rem;
    margin: -2.5rem 0 0 -2.5rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    pointer-events: none;
    opacity: 0;
    scale: 0.4;
    transition: opacity 0.25s ease, scale 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .drag-cursor svg { width: 0.8rem; height: 0.8rem; }
  .drag-cursor.is-on { opacity: 1; scale: 1; }
  .drag-cursor.is-down { scale: 0.8; }
  @media (hover: hover) and (pointer: fine) {
    .motion .is-js ~ .drag-cursor { display: flex; }
    .motion .marquee-rows.is-js .marquee-row { cursor: none; }
  }

  /* 끌기 표시 (터치): 사진 아래 작은 안내 */
  .drag-hint { display: none; margin-top: 1.25rem; text-align: center; font-size: 0.8rem; color: var(--color-muted); }
  @media (hover: none) { .motion .is-js ~ .drag-hint { display: block; } }

</style>

<script>
  import { motionOn } from '../../../scripts/scroll';

  // 사진 줄: 저절로 흐르다가, 사진에 마우스를 올리면 멈추고, 잡고 끌면 따라 움직임
  const rows = document.querySelector<HTMLElement>('.marquee-rows');
  if (rows && motionOn()) {
    rows.classList.add('is-js');
    const DURATION = 130; // 묶음 하나가 지나가는 시간(초) - 예전 CSS 흐름과 같은 속도
    const lines = [...rows.querySelectorAll<HTMLElement>('.marquee-row')].map((el) => ({
      el,
      dir: el.classList.contains('is-reverse') ? 1 : -1,
      x: 0,
      half: 0,
      drag: null as null | { id: number; lastX: number },
    }));
    let hovering = false;

    // 끌기 표시 동그라미: 마우스가 사진 줄 위에 있을 때만 커서를 따라다님
    const cursor = rows.parentElement?.querySelector<HTMLElement>('.drag-cursor');
    if (cursor) {
      rows.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        cursor.style.translate = `${e.clientX}px ${e.clientY}px`;
        cursor.classList.add('is-on');
      });
      rows.addEventListener('pointerleave', () => cursor.classList.remove('is-on', 'is-down'));
    }

    const measure = () => lines.forEach((l) => (l.half = l.el.scrollWidth / 2));
    // 묶음 하나 길이(half) 안에서 계속 돌게 (-half ~ 0)
    const wrap = (x: number, half: number) => (half ? ((x % half) - half) % half : x);
    measure();
    lines.forEach((l) => (l.x = l.dir === 1 ? -l.half : 0));
    window.addEventListener('resize', measure);

    rows.addEventListener('pointerover', (e) => { if (e.pointerType === 'mouse') hovering = !!(e.target as HTMLElement).closest('.gallery-card'); });
    rows.addEventListener('pointerleave', () => (hovering = false));

    lines.forEach((l) => {
      l.el.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        l.drag = { id: e.pointerId, lastX: e.clientX };
        l.el.setPointerCapture(e.pointerId);
        l.el.classList.add('is-dragging');
      });
      l.el.addEventListener('pointermove', (e) => {
        if (!l.drag || l.drag.id !== e.pointerId) return;
        l.x = wrap(l.x + e.clientX - l.drag.lastX, l.half);
        l.drag.lastX = e.clientX;
      });
      const end = () => { l.drag = null; l.el.classList.remove('is-dragging'); cursor?.classList.remove('is-down'); };
      l.el.addEventListener('pointerdown', () => cursor?.classList.add('is-down'));
      l.el.addEventListener('pointerup', end);
      l.el.addEventListener('pointercancel', end);
    });

    let last = performance.now();
    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      lines.forEach((l) => {
        if (!l.drag && !hovering) l.x = wrap(l.x + (l.dir * l.half * dt) / DURATION, l.half);
        l.el.style.transform = `translate3d(${l.x}px, 0, 0)`;
      });
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
