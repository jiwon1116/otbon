---
// @ts-ignore 타입 정의가 없는 라이브러리 (빌드할 때만 쓰고, 브라우저로는 안 나감)
import { feature } from 'topojson-client';
// @ts-ignore
import { presimplify, simplify, quantile } from 'topojson-simplify';
import { geoMercator, geoPath, geoCentroid } from 'd3-geo';
import world from 'world-atlas/countries-50m.json';
// 첫 장면(세계 전체)용 가벼운 땅 모양
import worldLand from 'world-atlas/land-110m.json';
import { network } from '../../../data/site';
// 지사가 있는 성(행정구역) 경계. Natural Earth(퍼블릭 도메인)에서 필요한 곳만 뽑아 둔 것
import regions from '../../../data/regions.json';

/*
  지도는 빌드할 때 실제 국경 데이터로 SVG를 만들어 페이지에 바로 넣음.
  브라우저에서는 스크롤에 맞춰 '카메라'(이동·확대)와 강조색만 바꿈.
*/
const W = 1600;
const H = 1000;

// 해안선을 화면에서 티 안 나는 정도로 단순하게 (점 개수를 줄여 페이지를 가볍게)
const pre = presimplify(world as any);
const topo = simplify(pre, quantile(pre, 0.5));
const all: any[] = (feature(topo, topo.objects.countries) as any).features;

// 동아시아 ~ 동남아가 화면에 들어오게 맞춤
const projection = geoMercator()
  .fitExtent([[0, 0], [W, H]], { type: 'MultiPoint', coordinates: [[72, 4], [146, 52]] } as any)
  // 카메라가 갈 수 있는 범위 밖은 잘라냄 (페이지 크기를 줄이려고)
  .clipExtent([[-W * 0.4, -H * 0.4], [W * 1.4, H * 1.4]]);
const path = geoPath(projection).digits(1);

// 세계 전체 땅: 같은 투영으로, 남극·북극 끝은 잘라냄 (첫 장면에서만 보이고 확대하면 자세한 지도로 바뀜)
const wx0 = projection([-180, 0])![0];
const wx1 = projection([180, 0])![0];
const wy0 = projection([0, 78])![1];
const wy1 = projection([0, -56])![1];
const worldPath = geoPath(
  geoMercator().scale(projection.scale()).translate(projection.translate()).clipExtent([[wx0, wy0], [wx1, wy1]]),
).digits(0);
const worldShape = worldPath(feature(worldLand as any, (worldLand as any).objects.land) as any) ?? '';
const worldCam = { cx: (wx0 + wx1) / 2, cy: (wy0 + wy1) / 2 + (wy1 - wy0) * 0.06, k: (W / (wx1 - wx0)) * 0.98 };

// 화면 근처 나라만 그림 (페이지 크기를 줄이려고)
const land = all
  .map((f) => ({ id: Number(f.id), d: path(f) ?? '' }))
  .filter((c) => c.d && !network.offices.some((o) => o.code === c.id));

const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

// 나라마다 카메라 위치(가운데 좌표 cx, cy)와 확대 배율 k
const offices = network.offices.map((o) => {
  const f = all.find((c) => Number(c.id) === o.code);
  const [[x0, y0], [x1, y1]] = path.bounds(f);
  // 도시마다 점 위치: pin 좌표가 있으면 그곳, 없으면 나라 한가운데
  const cities = o.cities.map((c) => {
    const [x, y] = projection(c.pin ?? geoCentroid(f))!;
    return { ...c, x, y };
  });
  // 카메라는 그 나라 도시들의 가운데를 비춤
  const cx = cities.reduce((s, c) => s + c.x, 0) / cities.length;
  const cy = cities.reduce((s, c) => s + c.y, 0) / cities.length;
  const k = o.zoom ?? clamp(0.42 * Math.min(W / (x1 - x0), H / (y1 - y0)), 1, 2.6);
  // region이 있으면 그 행정구역 모양만 강조
  const r = o.region ? (regions as any).features.find((x: any) => x.id === o.region) : null;
  return { ...o, d: path(f) ?? '', area: r ? path(r) ?? '' : '', cities, cx, cy, k };
});

// 본사 → 지사 곡선 (본사 첫 도시 → 지사에서 본사와 가장 가까운 도시)
const [hq, ...branches] = offices;
const from = hq.cities[0];
const lines = branches.map((b) => {
  const to = [...b.cities].sort((p, q) => Math.hypot(p.x - from.x, p.y - from.y) - Math.hypot(q.x - from.x, q.y - from.y))[0];
  const mx = (from.x + to.x) / 2;
  const my = (from.y + to.y) / 2;
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  // 선 중간을 옆으로 살짝 띄워 곡선으로
  const qx = mx - dy * 0.25;
  const qy = my + dx * 0.25;
  return `M${from.x.toFixed(1)} ${from.y.toFixed(1)} Q${qx.toFixed(1)} ${qy.toFixed(1)} ${to.x.toFixed(1)} ${to.y.toFixed(1)}`;
});

// 움직임이 없을 때 보여줄 전체 화면 (세 나라가 다 들어오게)
const xs = offices.map((o) => o.cx);
const ys = offices.map((o) => o.cy);
const overview = {
  cx: (Math.min(...xs) + Math.max(...xs)) / 2,
  cy: (Math.min(...ys) + Math.max(...ys)) / 2,
  k: clamp(0.6 * Math.min(W / (Math.max(...xs) - Math.min(...xs)), H / (Math.max(...ys) - Math.min(...ys))), 1, 2),
};
const toTransform = (c: { cx: number; cy: number; k: number }) =>
  `translate(${(W / 2 - c.k * c.cx).toFixed(1)} ${(H * 0.42 - c.k * c.cy).toFixed(1)}) scale(${c.k.toFixed(3)})`;

// 장면 순서: 세계 전체 → 한국 → 중국 → 베트남
const camera = JSON.stringify([worldCam, ...offices.map(({ cx, cy, k }) => ({ cx, cy, k }))]);
const intro = network.intro;
---

<!--
  본사·지사 지도
  - 검은 화면에 회색 지도. 처음엔 세계 지도 전체가 보이고, 스크롤하면 한국으로 확대된 뒤 한국 → 중국 → 베트남 순으로 지도가 이동하며 나라가 강조되고,
    본사에서 지사로 선이 그려짐
  - '동작 줄이기' 사용자나 JS가 꺼진 환경에선 세 나라가 모두 강조된 지도 한 장으로 보임
-->
<section id="network" class="net relative bg-ink text-white" data-network data-camera={camera} data-w={W} data-h={H}>
  <div class="net-stage relative h-svh min-h-[560px] overflow-hidden">
    <svg
      class="absolute inset-0 h-full w-full"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <g class="net-cam" transform={toTransform(overview)}>
        <!-- 세계 전체 (첫 장면). 확대하면 자세한 지도(net-detail)와 서서히 바뀜 -->
        <g class="net-land net-world"><path d={worldShape} /></g>
        <g class="net-detail">
        <g class="net-land">
          {land.map((c) => <path d={c.d} />)}
        </g>
        <!-- region이 있는 나라는 땅은 회색 그대로 두고, 그 행정구역만 칠함 -->
        <g class="net-land">
          {offices.map((o) => o.area && <path d={o.d} />)}
        </g>
        <g class="net-offices">
          {offices.map((o) => <path class="net-office" d={o.area || o.d} />)}
        </g>
        <g class="net-lines">
          {lines.map((d) => <path class="net-line" d={d} pathLength="1" />)}
        </g>
        <!-- 도시: 점 + 이름. 안쪽 묶음(net-dot-in)은 확대해도 크기가 그대로이게 JS가 1/배율로 줄임 -->
        <g class="net-dots">
          {offices.map((o, i) =>
            o.cities.map((c) => {
              const left = c.side === 'left';
              return (
                <g class="net-dot" data-office={i} transform={`translate(${c.x.toFixed(1)} ${c.y.toFixed(1)})`}>
                  <g class="net-dot-in" transform={`scale(${(1 / overview.k).toFixed(3)})`}>
                    <circle class="net-pulse" r="5" />
                    <circle class="net-core" r="5" />
                    <text class="net-city" x={left ? -14 : 14} y={c.sub ? -2 : 6} text-anchor={left ? 'end' : 'start'}>{c.name}</text>
                    {c.sub && <text class="net-city-sub" x={left ? -14 : 14} y="15" text-anchor={left ? 'end' : 'start'}>{c.sub}</text>}
                  </g>
                </g>
              );
            }),
          )}
        </g>
        </g>
      </g>
    </svg>

    <!-- 글자: 위쪽 작은 이름표, 가운데 설명, 아래 큰 나라 이름 -->
    <p class="net-eyebrow absolute inset-x-0 top-[10%] text-center text-xs font-semibold tracking-[0.3em] text-white/60 sm:text-sm">
      {network.eyebrow}
    </p>

    <!-- 첫 장면 글자 -->
    <div class="net-panel pointer-events-none absolute inset-x-0 bottom-[8%] px-4 text-center">
      <p class="text-base font-semibold leading-relaxed sm:text-xl">
        {intro.caption.map((line) => <span class="block">{line}</span>)}
      </p>
      <h2 class="mt-6 text-6xl font-extrabold tracking-tight sm:text-8xl lg:text-9xl">{intro.name}</h2>
    </div>

    {offices.map((o) => (
      <div class="net-panel pointer-events-none absolute inset-x-0 bottom-[8%] px-4 text-center">
        <p class="text-xs font-bold tracking-[0.25em] text-white/70 sm:text-sm">{o.role}</p>
        <p class="mt-4 text-base font-semibold leading-relaxed sm:text-xl">
          {o.caption.map((line) => <span class="block">{line}</span>)}
        </p>
        <h2 class="mt-6 text-6xl font-extrabold tracking-tight sm:text-8xl lg:text-9xl">{o.name}</h2>
      </div>
    ))}

    <!-- 움직임이 없을 때: 세 곳을 한 줄로 -->
    <ul class="net-static absolute inset-x-0 bottom-[8%] flex justify-center gap-8 px-4 text-center sm:gap-16">
      {offices.map((o) => (
        <li>
          <p class="text-[10px] font-bold tracking-[0.2em] text-accent sm:text-xs">{o.role}</p>
          <p class="mt-2 text-3xl font-extrabold sm:text-5xl">{o.name}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:global>
  /* 검은 배경에서도 잘 보이도록 사이트 그린(#2e5b45)을 한 톤 밝게 */
  .net { --color-accent: #4f8f6d; --color-accent-dark: #3d7357; }

  .net-land path {
    fill: #262626;
    stroke: var(--color-ink);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }
  .net-office {
    fill: var(--color-accent);
    stroke: var(--color-ink);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
    transition: fill 0.6s ease, opacity 0.6s ease;
  }

  /* 선 굵기는 확대 배율에 맞춰 JS가 조절 (non-scaling-stroke를 쓰면 선 그리기 효과가 깨짐) */
  .net-line {
    fill: none;
    stroke: #fff;
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .net-core { fill: #fff; }
  /* 도시 이름: 지도 위에서도 잘 읽히게 검은 테두리를 글자 뒤에 깔음 */
  .net-city, .net-city-sub {
    paint-order: stroke;
    stroke: rgb(10 10 10 / 0.85);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .net-city { fill: #fff; font-size: 18px; font-weight: 700; }
  .net-city-sub { fill: rgb(255 255 255 / 0.65); font-size: 12px; font-weight: 500; letter-spacing: 0.04em; }
  .net-pulse {
    fill: #fff;
    transform-box: fill-box;
    transform-origin: center;
    animation: net-pulse 2s ease-out infinite;
  }
  @keyframes net-pulse {
    from { transform: scale(1); opacity: 0.6; }
    to { transform: scale(4); opacity: 0; }
  }

  /* 기본(움직임 없음): 지도 한 장 + 세 나라 목록 */
  .net-panel { display: none; text-shadow: 0 2px 16px rgb(0 0 0 / 0.45); }

  /* 움직임 모드: 긴 섹션 안에서 화면이 고정되고, 스크롤로 장면이 넘어감 */
  .motion .net { height: 500vh; }
  .net-world { opacity: 0; }
  .motion .net-stage { position: sticky; top: 0; }
  .motion .net-static { display: none; }
  .motion .net-panel { display: block; opacity: 0; will-change: opacity, transform; }
  .motion .net-cam { will-change: transform; }
  .motion .net-office { fill: #262626; }
  .motion .net-office.is-active { fill: var(--color-accent); }
  .motion .net-office.is-past { fill: var(--color-accent); opacity: 0.4; }
  .motion .net-line { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .motion .net-dot { opacity: 0; transition: opacity 0.5s ease; }
  .motion .net-dot.is-shown { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .net-pulse { animation: none; opacity: 0; }
  }
</style>

<script>
  import { onScrollFrame, motionOn, stickyProgress, clamp01 } from '../../../scripts/scroll';

  const section = document.querySelector<HTMLElement>('[data-network]');

  if (section && motionOn()) {
    const W = Number(section.dataset.w);
    const H = Number(section.dataset.h);
    const cams: { cx: number; cy: number; k: number }[] = JSON.parse(section.dataset.camera!);
    const n = cams.length;

    const cam = section.querySelector<SVGGElement>('.net-cam')!;
    const countries = [...section.querySelectorAll<SVGPathElement>('.net-office')];
    const lines = [...section.querySelectorAll<SVGPathElement>('.net-line')];
    const dots = [...section.querySelectorAll<SVGGElement>('.net-dot')];
    const dotInner = [...section.querySelectorAll<SVGGElement>('.net-dot-in')];
    const worldLayer = section.querySelector<SVGGElement>('.net-world')!;
    const detail = section.querySelector<SVGGElement>('.net-detail')!;
    const panels = [...section.querySelectorAll<HTMLElement>('.net-panel')];

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const smooth = (t: number) => t * t * (3 - 2 * t);

    let current = -1;

    // 세로로 긴 화면(모바일)에선 세계 지도 양옆이 잘리므로, 첫 장면을 한국 쪽으로 옮겨 한국이 보이게 함
    const world0 = { ...cams[0] };
    const stage = section.querySelector<HTMLElement>('.net-stage')!;
    const measure = () => {
      const visibleW = Math.min(W, (H * stage.clientWidth) / stage.clientHeight); // 화면에 보이는 viewBox 폭
      const half = visibleW / 2 / world0.k; // 화면 반폭(지도 단위)
      const korea = cams[1].cx;
      // 한국이 화면 오른쪽 1/4쯤에 오도록, 단 세계 지도 끝을 넘지 않게
      cams[0].cx = Math.min(world0.cx + (W / 2 / world0.k - half), Math.max(world0.cx, korea - half * 0.5));
    };

    const render = () => {
      // 나라마다 스크롤 구간을 똑같이 나누고, 구간 가운데쯤에서만 다음 나라로 넘어감(앞뒤로는 잠시 머무름)
      const raw = Math.min(n - 1, Math.max(0, stickyProgress(section) * n - 0.5));
      const i = Math.min(n - 2, Math.floor(raw));
      const s = i + smooth(clamp01((raw - i - 0.25) / 0.5));

      // 카메라: 두 나라 사이를 부드럽게 이동. 확대 배율은 로그로 섞어야 자연스러움
      const a = cams[Math.floor(s)];
      const b = cams[Math.min(n - 1, Math.floor(s) + 1)];
      const t = s - Math.floor(s);
      const k = Math.exp(lerp(Math.log(a.k), Math.log(b.k), t));
      // 다음 장면의 중심점(b)이 화면 위에서 곧게 가운데로 다가오게 → 그곳으로 빨려 들어가듯 확대됨
      const sx = lerp(a.k * (b.cx - a.cx), 0, t);
      const sy = lerp(a.k * (b.cy - a.cy), 0, t);
      const cx = b.cx - sx / k;
      const cy = b.cy - sy / k;
      cam.setAttribute('transform', `translate(${W / 2 - k * cx} ${H * 0.42 - k * cy}) scale(${k})`);

      // 세계 지도 ↔ 자세한 지도: 확대될수록 자세한 쪽이 보임
      // (자세한 지도는 가장자리가 잘려 있어서, 그 가장자리가 화면 밖으로 나갈 만큼 확대된 뒤에 나타나게 함)
      const z = clamp01((k - 0.8) / 0.5);
      detail.style.opacity = String(z);
      worldLayer.style.opacity = String(1 - z);

      // 점과 도시 이름 크기는 확대와 상관없이 같게
      dotInner.forEach((g) => g.setAttribute('transform', `scale(${1 / k})`));

      // 본사 → 지사 선: 해당 지사로 넘어가는 동안 그려짐 (장면 0은 세계, 1부터 나라)
      lines.forEach((line, j) => {
        line.style.strokeWidth = String(1.6 / k);
        line.style.strokeDashoffset = String(1 - clamp01(s - 1 - j));
      });

      // 글자: 지금 나라와 가까울수록 진하게
      panels.forEach((panel, j) => {
        const d = s - j;
        const o = clamp01(1 - Math.abs(d) * 2.5);
        panel.style.opacity = String(o);
        panel.style.transform = `translateY(${d * -40}px)`;
      });

      // 강조색: 지금 나라는 진하게, 지나온 나라는 옅게 (세계 장면에선 아무것도 강조 안 함)
      const active = Math.round(s) - 1;
      if (active !== current) {
        current = active;
        countries.forEach((c, j) => {
          c.classList.toggle('is-active', j === active);
          c.classList.toggle('is-past', j < active);
        });
        dots.forEach((dot) => dot.classList.toggle('is-shown', Number(dot.dataset.office) <= active));
      }
    };

    onScrollFrame(render, measure);
  }
</script>
