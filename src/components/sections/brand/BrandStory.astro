---
import { brandStory } from '../../../data/site';

// 심볼 풀이 그림 (viewBox 400x400, 원 중심 200,200 · 반지름 150)
// 정식 로고를 받기 전 임시로 그린 심볼(원 + 촘촘한 가로선). 로고를 받으면 모양을 로고에 맞춰 다듬기
const thread = {
  lead: 'M-130 250 C-70 330 -20 170 20 120 S70 110 98 110',
  lines:
    'M98 110 L302 110 C320 110 343 140 325 140 L75 140 C57 140 52 170 70 170 L330 170 C348 170 350 200 332 200 L68 200 C50 200 52 230 70 230 L330 230 C348 230 343 260 325 260 L75 260 C57 260 80 290 98 290 L302 290',
};
const globe = 'M200 50 A150 150 0 1 1 200 350 A150 150 0 1 1 200 50';

// 부분마다 붙는 설명표: 가리키는 점(from) → 글자 자리(to), 글자 정렬
const callouts = [
  { from: [302, 290], to: [352, 362], text: '실 · Thread', anchor: 'end', tx: 400, ty: 384 },
  { from: [94, 94], to: [54, 44], text: '지구 · Global', anchor: 'start', tx: 0, ty: 30 },
  { from: [306, 94], to: [346, 44], text: '이니셜 · OTBON', anchor: 'end', tx: 400, ty: 30 },
];
---

<!--
  CI 페이지 - 02 심볼 풀이 (스크롤 연출)
  - 스크롤하는 동안 화면이 멈춘 채 초록 실이 심볼을 그리며 부분별로 풀이
    실(가로선) → 지구(원) → 전체(OTBON). 지금 설명하는 부분만 초록색, 부분마다 설명표가 붙음
  - '동작 줄이기' 사용자나 JS가 꺼진 환경에선 처음부터 다 그려진 상태로 보임
-->
<section id="symbol" class="bs bg-white">
  <div class="bs-track" data-brand>
    <div class="bs-stage">
      <div class="mx-auto grid w-full max-w-7xl items-center gap-x-16 gap-y-10 px-4 py-24 sm:px-6 lg:grid-cols-12 lg:px-8 lg:py-0">
        <div class="bs-art relative mx-auto aspect-square w-full max-w-[280px] sm:max-w-[340px] lg:order-2 lg:col-span-6 lg:col-start-7 lg:max-w-[460px]">
          <svg class="bs-draw absolute inset-0 h-full w-full overflow-visible" data-phase="all" viewBox="0 0 400 400" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <defs>
              <!-- 들어오는 실은 왼쪽 끝이 흐려지며 시작 -->
              <linearGradient id="bs-fade" gradientUnits="userSpaceOnUse" x1="-130" y1="0" x2="20" y2="0">
                <stop offset="0" stop-color="var(--color-accent)" stop-opacity="0" />
                <stop offset="1" stop-color="var(--color-accent)" />
              </linearGradient>
            </defs>

            <!-- 완성될 모양을 아주 연하게 미리 깔아둠 -->
            <path d={thread.lines} class="bs-ghost" stroke-width="1.5" stroke-dasharray="2 7" />
            <path d={globe} class="bs-ghost" stroke-width="1.5" stroke-dasharray="2 7" />

            <!-- 그려지는 순서대로: 실(들어옴 → 가로선), 지구(원) -->
            <g class="bs-part" data-part="0">
              <path d={thread.lead} class="bs-line" data-thread pathLength="1" stroke-width="3.5" style="stroke: url(#bs-fade)" />
              <path d={thread.lines} class="bs-line" data-thread pathLength="1" stroke-width="3.5" />
            </g>
            <g class="bs-part" data-part="1">
              <path d={globe} class="bs-line" data-thread pathLength="1" stroke-width="3.5" />
            </g>
            <circle class="bs-needle" r="6" cx="-130" cy="250" />

            <!-- 설명표 -->
            {callouts.map((c, i) => (
              <g class="bs-callout" data-callout={i}>
                <circle cx={c.from[0]} cy={c.from[1]} r="5" />
                <path d={`M${c.from[0]} ${c.from[1]} L${c.to[0]} ${c.to[1]}`} stroke-width="1.5" />
                <text x={c.tx} y={c.ty} text-anchor={c.anchor}>{c.text}</text>
              </g>
            ))}
          </svg>
        </div>

        <!-- 의미 3단계: 큰 화면은 목록으로 차례로 켜지고, 작은 화면은 지금 단계만 보임 -->
        <div class="lg:order-1 lg:col-span-5">
          <p class="ci-eyebrow"><span>02</span>Symbol</p>
          <h2 class="mt-5 text-3xl font-bold leading-snug sm:text-4xl">심볼에 담긴 의미</h2>
          <ol class="bs-steps mt-8 lg:mt-12">
            {brandStory.cards.map((c, i) => (
              <li class="bs-step" data-step>
                <span class="bs-num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="text-lg font-bold sm:text-xl">{c.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted sm:text-base">{c.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .bs-ghost { stroke: rgb(10 10 10 / 0.13); }
  .bs-line { stroke: var(--color-accent); }
  .bs-part { transition: opacity 0.5s ease; }
  .bs-needle { fill: var(--color-accent); opacity: 0; }

  /* 설명표: 점 + 점선 + 글자 */
  .bs-callout { transition: opacity 0.5s ease; }
  .bs-callout circle { fill: var(--color-accent); }
  .bs-callout path { stroke: var(--color-ink); stroke-dasharray: 3 4; }
  .bs-callout text { fill: var(--color-ink); font-size: 17px; font-weight: 700; }

  .bs-steps { display: grid; }
  .bs-step {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid rgb(10 10 10 / 0.1);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .bs-num { font-size: 13px; font-weight: 600; color: var(--color-accent); font-variant-numeric: tabular-nums; }

  /* 움직임 모드: 긴 트랙 안에서 화면이 멈춘 채 부분별로 풀이 */
  .motion .bs-track { height: 360vh; }
  .motion .bs-stage { position: sticky; top: 0; height: 100svh; display: flex; align-items: center; }
  .motion .bs-line { stroke-dasharray: 1 1; stroke-dashoffset: 1; }
  .motion .bs-callout { opacity: 0; }
  /* 지금 설명하는 부분만 진하게: 지구 단계엔 가로선을 흐리게 */
  .motion .bs-draw[data-phase='1'] .bs-part[data-part='0'] { opacity: 0.18; }
  .motion .bs-draw[data-phase='0'] .bs-callout[data-callout='0'],
  .motion .bs-draw[data-phase='1'] .bs-callout[data-callout='1'],
  .motion .bs-draw[data-phase='2'] .bs-callout[data-callout='2'] { opacity: 1; }

  /* 작은 화면: 단계를 한 자리에 겹쳐두고 지금 단계만 보이게 */
  .motion .bs-step { grid-area: 1 / 1; opacity: 0; transform: translateY(10px); }
  .motion .bs-step[data-state='on'] { opacity: 1; transform: none; }

  @media (min-width: 1024px) {
    .motion .bs-step { grid-area: auto; opacity: 0.22; transform: none; }
    .motion .bs-step[data-state='on'] { opacity: 1; }
    .motion .bs-step[data-state='done'] { opacity: 0.5; }
  }
</style>

<script>
  import { onScrollFrame, motionOn, stickyProgress, clamp01 } from '../../../scripts/scroll';

  const track = document.querySelector<HTMLElement>('[data-brand]');

  if (track && motionOn()) {
    const draw = track.querySelector<SVGSVGElement>('.bs-draw')!;
    const paths = [...track.querySelectorAll<SVGPathElement>('[data-thread]')]; // 들어오는 실, 가로선, 원
    const lens = paths.map((p) => p.getTotalLength());
    const needle = track.querySelector<SVGCircleElement>('.bs-needle')!;
    const steps = [...track.querySelectorAll<HTMLElement>('[data-step]')];

    // 스크롤 진행도(0~1) 중 각 선이 그려지는 구간
    const ranges = [
      [0.04, 0.12],
      [0.12, 0.32],
      [0.4, 0.6],
    ];
    // 단계(실 · 지구 · OTBON)가 시작되는 지점
    const phaseAt = [0.04, 0.4, 0.68];

    const render = () => {
      const p = stickyProgress(track);
      let head: DOMPoint | null = null;

      paths.forEach((path, i) => {
        const [a, b] = ranges[i];
        const t = clamp01((p - a) / (b - a));
        path.style.strokeDashoffset = String(1 - t);
        if (t > 0 && t < 1) head = path.getPointAtLength(lens[i] * t);
      });

      // 바늘(실 끝 점)은 선을 그리는 동안만 보임
      if (head) {
        needle.setAttribute('cx', String((head as DOMPoint).x));
        needle.setAttribute('cy', String((head as DOMPoint).y));
      }
      needle.style.opacity = head ? '1' : '0';

      let phase = -1;
      phaseAt.forEach((at, i) => { if (p >= at) phase = i; });
      draw.dataset.phase = String(phase);
      steps.forEach((s, i) => {
        s.dataset.state = i < phase ? 'done' : i === phase ? 'on' : '';
      });
    };

    onScrollFrame(render);
  }
</script>
