---
import { site } from '../../data/site';

// '이메일로 문의하기'를 누르면 제목과 적을 내용 틀이 미리 채워진 메일 쓰기 창이 열림
const subject = `[${site.nameKo} 제작 문의] `;
const body = [
  '안녕하세요, 제작 문의드립니다.',
  '',
  '1. 브랜드 / 회사명:',
  '2. 만들고 싶은 품목:',
  '3. 예상 수량:',
  '4. 희망 납기:',
  '5. 참고 이미지나 디자인 파일: (첨부해 주세요)',
  '',
  '연락처:',
].join('\n');
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

// 문의 진행 3단계. icon = 아래 icons 의 이름
const steps = [
  {
    icon: 'mail',
    title: '메일 보내기',
    desc: '만들고 싶은 옷에 대해 알려주세요.',
    list: ['품목과 예상 수량', '희망 납기', '참고 이미지 또는 디자인 파일'],
  },
  {
    icon: 'reply',
    title: '1일 이내 회신',
    desc: '영업일 기준 하루 안에 담당자가 직접 답장드립니다. 필요한 내용은 함께 정리해 드립니다.',
  },
  {
    icon: 'visit',
    title: '상담 · 방문',
    desc: '이메일 상담을 기본으로 하며, 원단과 샘플을 직접 보고 싶으시면 방문 상담을 예약해 드립니다.',
  },
];

const icons: Record<string, string> = {
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M4 7.5l8 5.5 8-5.5"/>',
  reply: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  visit: '<path d="M12 20.5s6.5-5.6 6.5-10.5a6.5 6.5 0 10-13 0c0 4.9 6.5 10.5 6.5 10.5z"/><circle cx="12" cy="10" r="2.3"/>',
};
---

<!--
  문의: 가운데 큰 질문 + 큰 이메일 주소(누르면 메일 쓰기, 옆 버튼으로 주소 복사)
  아래 둥근 카드 3장으로 문의가 어떻게 진행되는지 보여주고, 맨 아래 문의 버튼
  상단 메뉴 · 하단의 '견적 문의'는 이 섹션(#contact)으로 이동
-->
<section id="contact" class="scroll-mt-20 bg-soft">
  <div class="mx-auto max-w-7xl px-4 py-28 sm:px-6 lg:px-8 lg:py-36">
    <div class="text-center" data-reveal>
      <p class="text-xs font-medium tracking-[0.25em] text-muted sm:text-sm">CONTACT</p>
      <h2 class="mt-6 text-3xl font-semibold leading-snug tracking-tight sm:text-5xl sm:leading-tight">
        어떤 옷을 준비하고 계신가요?
      </h2>
      <p class="mx-auto mt-5 max-w-md leading-relaxed text-muted">
        아직 정해진 게 많지 않아도 괜찮습니다.<br class="hidden sm:block" /> 참고 이미지 한 장으로도 상담을 시작할 수 있습니다.
      </p>

      <div class="mt-10 flex flex-col items-center gap-3">
        <a href={mailto} class="contact-mail group inline-flex items-center gap-2 text-2xl font-medium tracking-tight sm:text-4xl">
          <span class="contact-mail-text">{site.email}</span>
          <svg class="h-6 w-6 shrink-0 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 sm:h-8 sm:w-8" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" /></svg>
        </a>
        <button type="button" class="contact-copy" data-copy={site.email}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5" /><path d="M16 8V6.5A2.5 2.5 0 0013.5 4h-7A2.5 2.5 0 004 6.5v7A2.5 2.5 0 006.5 16H8" /></svg>
          <span data-copy-label>주소 복사</span>
        </button>
      </div>
    </div>

    <ol class="mt-16 grid gap-4 md:grid-cols-3 lg:mt-20 lg:gap-6">
      {steps.map((s, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 110}ms`}>
          <div class="contact-step h-full">
          <div class="flex items-center justify-between">
            <span class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} />
            </span>
            <span class="text-sm tabular-nums text-muted">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mt-8 text-xl font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-muted">{s.desc}</p>
          {s.list && (
            <ul class="mt-5 space-y-2 text-[15px]">
              {s.list.map((item) => (
                <li class="flex items-center gap-2.5">
                  <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          )}
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-12 flex justify-center" data-reveal>
      <a href={mailto} class="contact-btn">
        이메일로 문의하기
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* 큰 이메일 주소: 마우스를 올리면 초록으로 바뀌고 밑줄이 왼쪽부터 그어짐 */
  .contact-mail { transition: color 0.3s ease; }
  .contact-mail:hover { color: var(--color-accent); }
  .contact-mail-text {
    background: linear-gradient(currentColor, currentColor) left bottom / 0% 1px no-repeat;
    padding-bottom: 0.1em;
    transition: background-size 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .contact-mail:hover .contact-mail-text { background-size: 100% 1px; }

  /* 주소 복사: 작은 알약 버튼 */
  .contact-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgb(40 40 40 / 0.15);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--color-muted);
    transition: border-color 0.3s ease, color 0.3s ease, background-color 0.3s ease;
  }
  .contact-copy:hover { border-color: var(--color-ink); color: var(--color-ink); background: #fdfbf7; }
  .contact-copy svg { width: 0.9rem; height: 0.9rem; }

  /* 단계 카드: 바탕보다 밝은 따뜻한 흰색, 마우스를 올리면 살짝 떠오름 */
  .contact-step {
    padding: 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: #fdfbf7;
    box-shadow: 0 1px 2px rgb(40 40 40 / 0.04);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s ease;
  }
  @media (min-width: 1024px) { .contact-step { padding: 2.25rem; } }
  .contact-step:hover { transform: translateY(-4px); box-shadow: 0 16px 36px -16px rgb(40 40 40 / 0.18); }

  /* 단계 아이콘: 연한 초록 동그라미 */
  .contact-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: rgb(46 91 69 / 0.09);
    color: var(--color-accent);
  }
  .contact-icon svg { width: 1.4rem; height: 1.4rem; }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    padding: 1.05rem 1.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-weight: 500;
    transition: background-color 0.3s ease;
  }
  .contact-btn:hover { background: var(--color-accent-dark); }
  .contact-btn svg { width: 1rem; height: 1rem; transition: transform 0.3s ease; }
  .contact-btn:hover svg { transform: translateX(4px); }
</style>

<script>
  // '주소 복사' → 클립보드에 이메일 주소를 넣고 잠깐 '복사됨' 표시
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = '복사됨';
      } catch {
        label.textContent = btn.dataset.copy!;
      }
      setTimeout(() => (label.textContent = '주소 복사'), 1800);
    });
  });
</script>
