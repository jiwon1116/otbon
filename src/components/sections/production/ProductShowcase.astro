---
import { products as P, type ProductImg } from '../../../data/site';

// 사진 한 칸: 앞면 주소 + (있으면) 뒷면 주소
const face = (p: ProductImg) => (typeof p === 'string' ? { src: p, back: '' } : { src: p.src, back: p.back ?? '' });

const num = (i: number) => String(i + 1).padStart(2, '0');
// 사진이 아직 없는 품목은 빈 칸 5개로 자리만 보여줌
const EMPTY = 5;
---

<!--
  생산 분야 > 제품: 품목(셔츠 · 재킷 · 점퍼 …)마다 한 구역씩.
  문구 · 사진은 src/data/site.ts 의 products
  - 위: 제목 · 설명, 그 아래 품목 바로가기(전체 / 셔츠 / 재킷 …). 내리는 동안 위에 붙어 있고 지금 보는 품목이 초록
  - 품목 구역: 바로가기 아래에 화면이 멈추고, 아래로 스크롤하는 만큼 사진 줄이 옆으로 부드럽게 흘러감
      · 오른쪽 위 지금 번호 / 전체 장수, 아래 얇은 진행선. 사진 안쪽도 살짝 반대로 움직여 깊이감
      · 움직임 줄이기 설정이면 멈추지 않고 손으로 옆으로 밀어서 봄
  - 뒷면 사진이 있는 칸은 마우스를 올리면 뒷면
  - 사진을 누르면 크게 보기 창(맨 아래 dialog). 창 안에서 한 번 더 누르면 2배 확대, ← → 로 같은 품목 넘기기, 뒷면 있으면 뒷면 보기 버튼
-->
<section id="products" class="scroll-mt-20">
  <div class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8 lg:pt-16" data-reveal>
    <p class="pd-eyebrow">{P.en.toUpperCase()}</p>
    <h2 class="pd-title">{P.title}</h2>
    <p class="pd-desc">{P.desc.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
  </div>

  <!-- 품목 바로가기 (내리는 동안 헤더 아래에 붙어 있음). 글자 + 지금 품목 밑줄 -->
  <nav class="pd-nav" aria-label="제품 품목" data-pd-nav>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="pd-tabs">
        <a href="#products" class="pd-tab" data-pd-tab="all">전체</a>
        {P.items.map((it) => <a href={`#pd-${it.en.toLowerCase()}`} class="pd-tab" data-pd-tab={it.en.toLowerCase()}>{it.name}</a>)}
      </div>
    </div>
  </nav>

  <!-- 끌 수 있다는 표시: 마우스 화면에서 사진 줄 위에 있으면 커서 대신 초록 동그라미가 따라다님 (홈 제작 현장과 같은 모양) -->
  <div class="pd-cursor" aria-hidden="true" data-pd-cursor></div>

  <div class="pb-16 lg:pb-24">
    {P.items.map((it, i) => {
      const id = it.en.toLowerCase();
      const photos = (it.imgs.length ? (it.imgs as ProductImg[]) : Array(EMPTY).fill('')).map(face);
      return (
        <div id={`pd-${id}`} class="pd-row" data-pd-row={id} data-count={photos.length}>
          <div class="pd-stage">
            <div class="pd-head mx-auto flex w-full max-w-7xl items-end justify-between gap-6 px-4 sm:px-6 lg:px-8">
              <div class="flex items-baseline gap-3.5">
                <span class="pd-no">{num(i)}</span>
                <h3 class="pd-name">{it.name}</h3>
                <span class="pd-en">{it.en}</span>
              </div>
              {it.imgs.length > 0 && (
                <p class="pd-count" aria-hidden="true"><b data-pd-now>01</b> / {String(photos.length).padStart(2, '0')}</p>
              )}
            </div>
            <ul class="pd-track" data-pd-track>
              {photos.map(({ src, back }, k) => (
                <li class:list={['pd-item', back && 'has-back', src && 'is-zoomable']} data-pd-item={src ? '' : undefined} data-src={src || undefined} data-back={back || undefined} data-name={it.name} data-k={k}>
                  <div class="pd-photo">
                    <div class="pd-in" data-pd-in>
                      {src
                        ? <img src={src} alt={`${it.name} 제작 사례 ${k + 1}`} loading="lazy" draggable="false" />
                        : <span class="pd-empty" aria-hidden="true">{it.en}</span>}
                      {back && <img class="pd-back" src={back} alt={`${it.name} 제작 사례 ${k + 1} 뒷면`} loading="lazy" draggable="false" />}
                    </div>
                  </div>
                  {src && <p class="pd-cap"><span>{it.en}</span><span>{num(k)}</span></p>}
                </li>
              ))}
            </ul>
            <div class="pd-prog" aria-hidden="true"><i data-pd-prog></i></div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- 크게 보기: 사진을 누르면 열림. 사진을 한 번 더 누르면 누른 곳이 확대(마우스를 움직이면 따라 이동), ← → 로 같은 품목 다음 사진 -->
  <dialog class="lb" aria-label="제품 사진 크게 보기" data-lb>
    <div class="lb-top">
      <p class="lb-title"><span data-lb-name></span> <b data-lb-now>01</b> / <span data-lb-total>01</span></p>
      <div class="lb-tools">
        <button type="button" class="lb-side" data-lb-side hidden>뒷면 보기</button>
        <button type="button" class="lb-x" data-lb-close aria-label="닫기">✕</button>
      </div>
    </div>
    <div class="lb-stage" data-lb-stage>
      <img class="lb-img" alt="" data-lb-img draggable="false" />
    </div>
    <button type="button" class="lb-arrow lb-prev" data-lb-prev aria-label="이전 사진">←</button>
    <button type="button" class="lb-arrow lb-next" data-lb-next aria-label="다음 사진">→</button>
    <p class="lb-hint" data-lb-hint>사진을 누르면 확대해서 구석구석 볼 수 있어요</p>  </dialog>
</section>

<style>
  /* ---- 크게 보기 ---- */
  .pd-item.is-zoomable .pd-photo { cursor: zoom-in; }
  .lb { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(245 241 232 / 0.97); color: var(--color-ink); overflow: hidden; }
  .lb::backdrop { background: transparent; }
  .lb[open] { animation: lb-in 0.3s ease both; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  .lb-top { position: absolute; left: 0; right: 0; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; }
  @media (min-width: 1024px) { .lb-top { padding: 24px 40px; } }
  .lb-title { font-size: 12px; font-weight: 600; letter-spacing: 0.16em; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .lb-title [data-lb-name] { margin-right: 10px; color: var(--color-ink); letter-spacing: 0.02em; font-size: 14px; }
  .lb-title b { color: var(--color-ink); }
  .lb-tools { display: flex; align-items: center; gap: 8px; }
  .lb-side { padding: 8px 14px; font-size: 13px; font-weight: 600; border: 1px solid var(--color-line); border-radius: 999px; background: #faf6ee; transition: border-color 0.2s; }
  .lb-side:hover { border-color: var(--color-ink); }
  .lb-x { width: 40px; height: 40px; font-size: 18px; line-height: 1; border-radius: 999px; transition: background 0.2s; }
  .lb-x:hover { background: var(--color-soft); }
  /* 사진 무대는 화면 전체 → 확대하면 화면 끝까지 넓게 보임. 손동작(끌기 · 두 손가락 확대)은 스크립트가 직접 처리 */
  .lb-stage { position: absolute; inset: 0; overflow: hidden; cursor: zoom-in; touch-action: none; }
  /* 확대 전: 위 · 아래 글자 자리를 뺀 칸 안에 사진 전체가 비율대로(contain) 들어옴 */
  .lb-img { position: absolute; left: 16px; top: 72px; width: calc(100% - 32px); height: calc(100% - 128px); max-width: none; object-fit: contain; user-select: none; -webkit-user-drag: none; transform-origin: 50% 50%; will-change: transform; transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1); }
  @media (min-width: 1024px) { .lb-img { left: 120px; top: 88px; width: calc(100% - 240px); height: calc(100% - 152px); } }
  /* 확대 중: 손바닥(잡기) 커서, 누르고 있는 동안은 쥔 손 */
  .lb.is-zoom .lb-stage { cursor: grab; }
  .lb.is-zoom.is-drag .lb-stage { cursor: grabbing; }
  /* 끄는 중 · 두 손가락 확대 중엔 바로 따라옴 */
  .lb.is-drag .lb-img { transition: none; }
  .lb-top { pointer-events: none; }
  .lb-top > * { pointer-events: auto; }
  .lb-arrow { position: absolute; top: 50%; z-index: 2; width: 48px; height: 48px; margin-top: -24px; font-size: 18px; border-radius: 999px; transition: background 0.2s, opacity 0.2s; }
  .lb-arrow:hover { background: var(--color-soft); }
  .lb-prev { left: 8px; }
  .lb-next { right: 8px; }
  @media (min-width: 1024px) { .lb-prev { left: 40px; } .lb-next { right: 40px; } }
  .lb.is-zoom .lb-arrow, .lb.is-single .lb-arrow { opacity: 0; pointer-events: none; }
  .lb-hint { position: absolute; left: 0; right: 0; bottom: 20px; text-align: center; font-size: 12px; color: var(--color-muted); transition: opacity 0.3s; }
  .lb.is-zoom .lb-hint { opacity: 0; }

  /* 헤더(휴대폰 64px · 큰 화면 80px) + 바로가기 줄(52px) 아래에서 품목 화면이 멈춤 */
  #products { --nav-h: 52px; --pin-top: calc(4rem + var(--nav-h)); }
  @media (min-width: 1024px) { #products { --pin-top: calc(5rem + var(--nav-h)); } }

  /* 위: 큰 제목 → 설명 */
  .pd-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.28em; color: var(--color-accent); }
  .pd-title { margin-top: 18px; font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.05; }
  .pd-desc { margin-top: 20px; font-size: 15px; line-height: 1.75; color: var(--color-muted); }
  @media (min-width: 640px) { .pd-desc { font-size: 16px; } }

  /* 품목 바로가기: 글자만, 지금 품목에 밑줄. 아래 얇은 선 */
  .pd-nav { position: sticky; top: 4rem; z-index: 20; margin-top: 40px; background: var(--color-paper); }
  @media (min-width: 1024px) { .pd-nav { top: 5rem; margin-top: 48px; } }
  .pd-tabs { display: flex; gap: 22px; height: var(--nav-h); border-bottom: 1px solid var(--color-line); overflow-x: auto; scrollbar-width: none; }
  @media (min-width: 640px) { .pd-tabs { gap: 32px; } }
  .pd-tabs::-webkit-scrollbar { display: none; }
  .pd-tab { position: relative; flex: none; display: flex; align-items: center; white-space: nowrap; font-size: 15px; font-weight: 600; color: var(--color-muted); transition: color 0.25s; }
  .pd-tab:hover { color: var(--color-ink); }
  .pd-tab::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--color-ink); transform: scaleX(0); transform-origin: 0 50%; transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
  .pd-tab.is-on { color: var(--color-ink); }
  .pd-tab.is-on::after { transform: scaleX(1); }

  /* 품목 한 구역: 높이는 스크립트가 (화면 + 옆으로 흐를 거리) 로 정함 */
  .pd-row { position: relative; scroll-margin-top: var(--pin-top); }
  .pd-stage { display: flex; flex-direction: column; justify-content: center; padding: 48px 0; }
  /* 품목 제목: 섹션 제목보다 한 단계 작게 */
  .pd-no { font-size: 13px; font-weight: 600; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .pd-name { font-size: clamp(1.5rem, 2.4vw, 1.875rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
  .pd-en { font-size: 12px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--color-muted); }
  .pd-count { font-size: 13px; font-weight: 600; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .pd-count b { color: var(--color-ink); }

  /* 사진 줄: 왼쪽은 본문 줄에 맞추고 오른쪽으로 쭉 이어짐 */
  .pd-track {
    --edge: max(1rem, calc((100vw - 80rem) / 2 + 2rem));
    display: flex;
    gap: 12px;
    margin-top: 24px;
    padding: 0 var(--edge);
  }
  @media (min-width: 640px) and (max-width: 1023px) { .pd-track { --edge: 1.5rem; } }
  @media (min-width: 1024px) { .pd-track { gap: 24px; margin-top: 28px; } }
  /* 카드 크기: 화면 높이에 맞춰 한 화면 안에 들어오게 */
  .pd-item { --w: min(78vw, calc((100svh - var(--pin-top) - 190px) * 0.8)); flex: none; width: var(--w); }
  @media (min-width: 640px) { .pd-item { --w: min(40vw, 400px, calc((100svh - var(--pin-top) - 200px) * 0.8)); } }
  @media (min-width: 1024px) { .pd-item { --w: min(28vw, 400px, calc((100svh - var(--pin-top) - 200px) * 0.8)); } }
  .pd-photo { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: #faf6ee; }
  .pd-in { position: absolute; inset: 0; transform: scale(1.06); will-change: transform; }
  .pd-in img { width: 100%; height: 100%; object-fit: cover; user-select: none; }
  .pd-cap { display: flex; justify-content: space-between; margin-top: 12px; font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .pd-empty { position: absolute; inset: 0; display: grid; place-items: center; font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 700; letter-spacing: -0.02em; color: rgb(40 40 40 / 0.1); }

  /* 뒷면 사진: 마우스를 올리면(휴대폰은 누르면) 천천히 겹쳐 나타남 */
  .pd-back { position: absolute; inset: 0; opacity: 0; transition: opacity 0.45s ease; }
  .pd-item.has-back:hover .pd-back, .pd-item.has-back.is-back .pd-back { opacity: 1; }

  /* 진행선 */
  .pd-prog { width: calc(100% - 2 * max(1rem, calc((100vw - 80rem) / 2 + 2rem))); max-width: 76rem; margin: 32px auto 0; height: 1px; background: var(--color-line); }
  @media (min-width: 640px) and (max-width: 1023px) { .pd-prog { width: calc(100% - 3rem); } }
  .pd-prog i { display: block; height: 100%; background: var(--color-ink); transform-origin: 0 50%; transform: scaleX(0); }

  /* 멈추는 모드 (스크립트가 .is-pin 을 붙임): 바로가기 아래에 화면이 고정되고 줄이 옆으로 흐름 */
  .pd-row.is-pin .pd-stage { position: sticky; top: var(--pin-top); height: calc(100svh - var(--pin-top)); justify-content: flex-start; padding: clamp(28px, 6vh, 64px) 0 0; overflow: hidden; }
  /* 손으로 끌기: 마우스는 손 모양, 터치는 세로 스크롤만 브라우저에 맡기고 옆으로 미는 건 직접 처리 */
  .pd-row.is-pin .pd-track { will-change: transform; cursor: grab; touch-action: pan-y; user-select: none; }
  .pd-row.is-pin .pd-track.is-drag { cursor: grabbing; }

  /* 초록 동그라미 커서 (마우스 화면만). 잡으면 살짝 작아짐 */
  .pd-cursor { position: fixed; left: 0; top: 0; z-index: 40; display: none; width: 3.25rem; height: 3.25rem; margin: -1.625rem 0 0 -1.625rem; border-radius: 999px; background: var(--color-accent); pointer-events: none; opacity: 0; scale: 0.4; transition: opacity 0.25s ease, scale 0.3s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .pd-cursor.is-on { opacity: 0.7; scale: 1; }
  .pd-cursor.is-down { scale: 0.8; }
  @media (hover: hover) and (pointer: fine) {
    .pd-cursor.is-ready { display: block; }
    .pd-row.is-pin .pd-track, .pd-row.is-pin .pd-track.is-drag { cursor: none; }
  }

  /* 멈추지 않는 모드: 손으로 옆으로 밀어서 봄 */
  .pd-row:not(.is-pin) .pd-track { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge); scrollbar-width: none; }
  .pd-row:not(.is-pin) .pd-track::-webkit-scrollbar { display: none; }
  .pd-row:not(.is-pin) .pd-item { scroll-snap-align: start; }
  .pd-row:not(.is-pin) .pd-prog { display: none; }
</style>

<script>
  import { onScrollFrame, clamp01 } from '../../../scripts/scroll';

  const rows = [...document.querySelectorAll<HTMLElement>('[data-pd-row]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- 가로 스크롤: 구역을 지나가는 동안 사진 줄이 옆으로 흐름 ----
  if (!reduce) {
    const state = rows.map((row) => ({
      row,
      stage: row.querySelector<HTMLElement>('.pd-stage')!,
      track: row.querySelector<HTMLElement>('[data-pd-track]')!,
      ins: [...row.querySelectorAll<HTMLElement>('[data-pd-in]')],
      prog: row.querySelector<HTMLElement>('[data-pd-prog]'),
      now: row.querySelector<HTMLElement>('[data-pd-now]'),
      count: Number(row.dataset.count),
      dist: 0,
      // 스크롤 거리: 처음에 잠깐 머묾(holdIn) → 옆으로 흐름(run) → 끝에서 잠깐 머묾(holdOut)
      holdIn: 0,
      run: 0,
      target: 0,
      cur: 0,
    }));
    const pad = (n: number) => String(n).padStart(2, '0');

    const measure = () => {
      state.forEach((s) => {
        s.row.classList.add('is-pin');
        s.track.style.transform = '';
        // 마지막 사진이 오른쪽 여백에 닿을 때까지 흐를 거리
        const last = s.track.lastElementChild as HTMLElement | null;
        const edge = parseFloat(getComputedStyle(s.track).paddingLeft) || 16;
        s.dist = last ? Math.max(0, last.offsetLeft + last.offsetWidth + edge - window.innerWidth) : 0;
        // 옆으로 흐르는 거리만큼 스크롤 (조금 더 길게 → 천천히)
        s.run = s.dist * 1.15;
        s.holdIn = s.dist > 0 ? window.innerHeight * 0.12 : 0;
        // 마지막 사진까지 다 보이고 나서도 잠깐 멈춰 있다가 다음 품목으로
        const holdOut = s.dist > 0 ? window.innerHeight * 0.45 : 0;
        s.row.style.height = `calc(100svh - var(--pin-top) + ${Math.round(s.holdIn + s.run + holdOut)}px)`;
      });
    };

    let raf = 0;
    const paint = () => {
      raf = 0;
      let moving = false;
      state.forEach((s) => {
        const d = s.target - s.cur;
        s.cur = Math.abs(d) < 0.0005 ? s.target : s.cur + d * 0.16;
        if (s.cur !== s.target) moving = true;
        const c = s.cur;
        s.track.style.transform = `translate3d(${(-c * s.dist).toFixed(1)}px,0,0)`;
        // 사진 안쪽은 살짝 반대로 → 깊이감
        s.ins.forEach((el, k) => {
          const rel = Math.max(-1, Math.min(1, c * (s.count - 1) - k));
          el.style.transform = `scale(1.06) translate3d(${(-rel * 2.5).toFixed(2)}%,0,0)`;
        });
        if (s.prog) s.prog.style.transform = `scaleX(${c.toFixed(4)})`;
        if (s.now) s.now.textContent = pad(Math.round(c * (s.count - 1)) + 1);
      });
      if (moving) raf = requestAnimationFrame(paint);
    };

    onScrollFrame(() => {
      state.forEach((s) => {
        const r = s.row.getBoundingClientRect();
        const top = parseFloat(getComputedStyle(s.stage).top) || 0;
        s.target = s.run > 0 ? clamp01((top - r.top - s.holdIn) / s.run) : 0;
      });
      if (!raf) raf = requestAnimationFrame(paint);
    }, measure);

    // ---- 초록 동그라미 커서: 마우스가 사진 줄 위에 있을 때만 따라다님 ----
    const cursor = document.querySelector<HTMLElement>('[data-pd-cursor]');
    if (cursor) {
      cursor.classList.add('is-ready');
      state.forEach((s) => {
        if (s.dist <= 0) return;
        s.track.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          cursor.style.translate = `${e.clientX}px ${e.clientY}px`;
          cursor.classList.add('is-on');
        });
        s.track.addEventListener('pointerleave', () => cursor.classList.remove('is-on', 'is-down'));
        s.track.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') cursor.classList.add('is-down'); });
        s.track.addEventListener('pointerup', () => cursor.classList.remove('is-down'));
      });
      // 스크롤로 사진 줄이 마우스 밑에서 빠져나가면 숨김
      window.addEventListener('scroll', () => {
        if (!cursor.classList.contains('is-on')) return;
        const [x, y] = (cursor.style.translate || '0px 0px').split(' ').map(parseFloat);
        const under = document.elementFromPoint(x, y)?.closest('.pd-row.is-pin .pd-track');
        if (!under) cursor.classList.remove('is-on', 'is-down');
      }, { passive: true });
    }

    // ---- 손으로 끌어서 넘기기: 옆으로 끈 만큼 페이지를 스크롤 → 사진 줄 · 진행선 · 번호가 그대로 따라옴 ----
    state.forEach((s) => {
      let start: { x: number; y: number; id: number } | null = null;
      let lastX = 0;
      let dragging = false;
      let moved = false;
      const range = () => {
        // 이 품목이 옆으로 흐르는 동안의 페이지 스크롤 위치 (처음 ~ 끝)
        const top = parseFloat(getComputedStyle(s.stage).top) || 0;
        const begin = s.row.getBoundingClientRect().top + window.scrollY - top + s.holdIn;
        return [begin, begin + s.run];
      };
      s.track.addEventListener('pointerdown', (e) => {
        if (s.dist <= 0 || (e.pointerType === 'mouse' && e.button !== 0)) return;
        start = { x: e.clientX, y: e.clientY, id: e.pointerId };
        lastX = e.clientX;
        dragging = false;
        moved = false;
      });
      s.track.addEventListener('pointermove', (e) => {
        if (!start || e.pointerId !== start.id) return;
        const dx = e.clientX - start.x;
        const dy = e.clientY - start.y;
        if (!dragging) {
          // 옆으로 6px 넘게, 세로보다 많이 움직였을 때만 끌기로 봄 (세로 스크롤은 그대로)
          if (Math.abs(dx) < 6 || Math.abs(dx) < Math.abs(dy)) return;
          dragging = true;
          moved = true;
          s.track.setPointerCapture(e.pointerId);
          s.track.classList.add('is-drag');
        }
        const step = e.clientX - lastX;
        lastX = e.clientX;
        const [a, b] = range();
        const y = Math.min(b, Math.max(a, window.scrollY - step * (s.run / s.dist)));
        window.scrollTo({ top: y, behavior: 'instant' as ScrollBehavior });
      });
      const end = (e: PointerEvent) => {
        if (!start || e.pointerId !== start.id) return;
        start = null;
        dragging = false;
        s.track.classList.remove('is-drag');
      };
      s.track.addEventListener('pointerup', end);
      s.track.addEventListener('pointercancel', end);
      // 끌고 난 직후의 클릭(휴대폰 앞 ↔ 뒤 바꾸기 등)은 무시
      s.track.addEventListener('click', (e) => { if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; } }, true);
    });
  }

  // ---- 크게 보기: 사진을 누르면 열림 (뒷면이 있으면 창 안에서 '뒷면 보기'로 바꿈) ----
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  if (lb) {
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const stage = lb.querySelector<HTMLElement>('[data-lb-stage]')!;
    const nameEl = lb.querySelector<HTMLElement>('[data-lb-name]')!;
    const nowEl = lb.querySelector<HTMLElement>('[data-lb-now]')!;
    const totalEl = lb.querySelector<HTMLElement>('[data-lb-total]')!;
    const sideBtn = lb.querySelector<HTMLButtonElement>('[data-lb-side]')!;
    const pad = (n: number) => String(n).padStart(2, '0');
    let list: HTMLElement[] = [];
    let at = 0;
    let backSide = false;

    // ---- 확대 상태: 배율(s) · 이동(tx, ty). 사진 칸 가운데를 기준으로 translate → scale ----
    const ZOOM = 2; // 누르면 이 배율로
    const MAX = 3; // 두 손가락 · 휠로 최대
    let s = 1, tx = 0, ty = 0;
    const apply = () => {
      img.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, 0) scale(${s.toFixed(3)})`;
      lb.classList.toggle('is-zoom', s > 1.01);
    };
    // 사진 칸 · 실제 사진이 그려진 크기 · 화면 가운데와의 차이
    const geo = () => {
      const W = stage.clientWidth, H = stage.clientHeight;
      const bw = img.offsetWidth, bh = img.offsetHeight;
      const r = img.naturalWidth && img.naturalHeight ? img.naturalWidth / img.naturalHeight : 0.8;
      const cw = Math.min(bw, bh * r), ch = cw / r;
      const bx = img.offsetLeft + bw / 2, by = img.offsetTop + bh / 2;
      return { W, H, cw, ch, bx, by, dx: bx - W / 2, dy: by - H / 2 };
    };
    // 사진이 화면보다 크면 가장자리가 화면 안으로 들어오지 않게, 작으면 가운데로
    const clamp = () => {
      if (s <= 1.001) { s = 1; tx = 0; ty = 0; return; }
      const g = geo();
      const hx = (g.cw * s - g.W) / 2, hy = (g.ch * s - g.H) / 2;
      tx = hx > 0 ? Math.min(hx - g.dx, Math.max(-hx - g.dx, tx)) : -g.dx;
      ty = hy > 0 ? Math.min(hy - g.dy, Math.max(-hy - g.dy, ty)) : -g.dy;
    };
    // 화면의 (qx, qy) 지점이 그대로 손가락/마우스 밑에 남도록 배율을 바꿈
    const zoomAt = (qx: number, qy: number, ns: number) => {
      const g = geo();
      const px = (qx - g.bx - tx) / s, py = (qy - g.by - ty) / s;
      s = Math.min(MAX, Math.max(1, ns));
      tx = qx - g.bx - s * px;
      ty = qy - g.by - s * py;
      clamp();
      apply();
    };
    const unzoom = () => { s = 1; tx = 0; ty = 0; lb.classList.remove('is-drag'); apply(); };
    const render = () => {
      const it = list[at];
      const back = it.dataset.back;
      if (!back) backSide = false;
      img.src = backSide && back ? back : it.dataset.src!;
      img.alt = `${it.dataset.name} 제작 사례 ${at + 1}${backSide ? ' 뒷면' : ''}`;
      nameEl.textContent = it.dataset.name!;
      nowEl.textContent = pad(at + 1);
      totalEl.textContent = pad(list.length);
      sideBtn.hidden = !back;
      sideBtn.textContent = backSide ? '앞면 보기' : '뒷면 보기';
      lb.classList.toggle('is-single', list.length < 2);
      unzoom();
    };
    const go = (d: number) => { at = (at + d + list.length) % list.length; backSide = false; render(); };

    document.querySelectorAll<HTMLElement>('[data-pd-item]').forEach((item) => {
      item.querySelector('.pd-photo')?.addEventListener('click', () => {
        list = [...item.parentElement!.querySelectorAll<HTMLElement>('[data-pd-item]')];
        at = list.indexOf(item);
        backSide = false;
        render();
        lb.showModal();
        document.documentElement.style.overflow = 'hidden';
      });
    });

    // ---- 손동작 ----
    // 누르기: 확대 전이면 누른 곳을 확대, 확대 중이면 원래대로. 사진 바깥 빈 곳을 누르면 닫힘
    // PC: 확대 중 마우스로 잡아 끌어서 이동(손바닥 커서), 휠로 더 크게/작게
    // 휴대폰: 확대 중 한 손가락으로 끌어서 이동, 두 손가락으로 벌리고 오므려 확대/축소
    const pts = new Map<number, { x: number; y: number }>();
    let moved = false;
    let pinch: { d: number; s: number } | null = null;
    let downAt = { x: 0, y: 0 };
    const mid = () => { const [a, b] = [...pts.values()]; return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2, d: Math.hypot(a.x - b.x, a.y - b.y) }; };

    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      stage.setPointerCapture(e.pointerId);
      if (s > 1.01 || e.pointerType !== 'mouse') lb.classList.add('is-drag'); // 끄는 동안은 바로 따라오게
      if (pts.size === 1) { moved = false; downAt = { x: e.clientX, y: e.clientY }; }
      if (pts.size === 2) { pinch = { d: mid().d, s }; moved = true; }
    });
    stage.addEventListener('pointermove', (e) => {
      const prev = pts.get(e.pointerId);
      if (!prev) return;
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (Math.hypot(e.clientX - downAt.x, e.clientY - downAt.y) > 8) moved = true;
      if (pts.size === 2 && pinch) {
        const m = mid();
        zoomAt(m.x, m.y, pinch.s * (m.d / pinch.d));
      } else if (pts.size === 1 && s > 1.01) {
        tx += e.clientX - prev.x;
        ty += e.clientY - prev.y;
        clamp();
        apply();
      }
    });
    const lift = (e: PointerEvent) => {
      pts.delete(e.pointerId);
      if (pts.size < 2) pinch = null;
      if (pts.size === 0) lb.classList.remove('is-drag');
    };
    stage.addEventListener('pointerup', lift);
    stage.addEventListener('pointercancel', lift);

    stage.addEventListener('click', (e) => {
      if (moved) { moved = false; return; } // 끌기 · 두 손가락 확대 직후 손을 뗀 건 누르기로 치지 않음
      if (s > 1.01) { unzoom(); return; }
      const g = geo();
      const ex = e.clientX - (g.bx - g.cw / 2), ey = e.clientY - (g.by - g.ch / 2);
      if (ex < 0 || ey < 0 || ex > g.cw || ey > g.ch) { lb.close(); return; }
      zoomAt(e.clientX, e.clientY, ZOOM);
    });
    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      const ns = Math.min(MAX, Math.max(1, s * Math.exp(-e.deltaY * 0.0025)));
      if (ns <= 1.01) { unzoom(); return; }
      zoomAt(e.clientX, e.clientY, ns); // 마우스가 있는 곳을 중심으로
    }, { passive: false });
    window.addEventListener('resize', () => { if (lb.open) { clamp(); apply(); } });
    // Esc: 확대 중이면 먼저 원래대로, 한 번 더 누르면 닫힘
    lb.addEventListener('cancel', (e) => { if (s > 1.01) { e.preventDefault(); unzoom(); } });

    sideBtn.addEventListener('click', () => { backSide = !backSide; render(); });
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => go(-1));
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => go(1));
    lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });
    lb.addEventListener('close', () => { unzoom(); document.documentElement.style.overflow = ''; });
  }

  // 지금 화면에 있는 품목을 바로가기에서 초록으로
  const tabs = new Map([...document.querySelectorAll<HTMLElement>('[data-pd-tab]')].map((t) => [t.dataset.pdTab!, t]));
  const setOn = (key: string) => tabs.forEach((t, k) => t.classList.toggle('is-on', k === key));
  setOn('all');
  const pick = () => {
    const line = window.innerHeight * 0.45;
    let cur = 'all';
    for (const r of rows) if (r.getBoundingClientRect().top < line) cur = r.dataset.pdRow!;
    setOn(cur);
  };
  window.addEventListener('scroll', pick, { passive: true });
  pick();
</script>
