---
import { fabricDev as F } from '../../../data/site';

// 사진이 있는 원단만 (사진 없는 조각은 보여주지 않음)
const shots = F.swatches.filter((w) => w.img);
// 이름이 같은 원단은 한 장으로 묶음 (같은 원단의 다른 컬러는 사진 아래 색 점으로 바꿔 봄)
const groups: { name: string; items: typeof shots }[] = [];
for (const w of shots) {
  const g = groups.find((x) => x.name === w.name);
  if (g) g.items.push(w);
  else groups.push({ name: w.name, items: [w] });
}
const pad = (n: number) => String(n).padStart(2, '0');
// 사진 ↔ 사례 줄은 원단 이름으로 연결. 종류 영문 표기 (사례 목록 오른쪽 작은 글자)
const kindEn = (kind: string) => (kind === 'woven' ? 'WOVEN' : 'DAIMARU');
---

<!--
  생산 분야 > 원단 개발 (제작 아카이브와 같은 모양: 각진 사진 · 얇은 선 · 글자 위주)
  - 왼쪽: 작은 영문 → 큰 제목 → 설명 → 조건 표(개발 범위 | 최소 수량) → 개발 사례 목록
      · 지금 보이는 원단과 같은 종류의 사례 줄만 진하고 나머지는 옅게
  - 오른쪽(휴대폰은 위): 원단 사진. 사진 · ← → · 사례 줄을 누르면 천천히 겹쳐 바뀌고 아주 느리게 살짝 확대됨
      · 사진 아래 캡션(번호 · 이름 · 색)과 지금 몇 번째인지, 그 아래 얇은 진행선
  문구 · 사진은 src/data/site.ts 의 fabricDev
-->
<section id="fabric" class="scroll-mt-20 bg-paper" data-fabric>
  <div class="mx-auto max-w-7xl px-4 pt-28 pb-24 sm:px-6 lg:px-8 lg:pt-48 lg:pb-32">
    <div class="fd-grid">
      <div class="fd-photo-col" data-reveal>
        <div class="fd-photo" data-fx-photo>
          {F.photo ? <img src={F.photo} alt="옷본이 개발한 원단" loading="lazy" /> : groups.flatMap((g, gi) => g.items.map((w, ci) => (
            <img class:list={['fd-shot', gi === 0 && ci === 0 && 'is-on', w.still && 'is-still']} src={w.img} alt={w.color ? `${w.name} ${w.color} 원단` : w.name} loading="lazy" data-fx-shot data-g={gi} data-c={ci} />
          )))}
        </div>
        {!F.photo && groups.length > 0 && (
          <>
            <div class="fd-cap">
              <div class="fd-cap-names">
                {groups.map((g, gi) => (
                  <p class:list={['fd-cap-name', gi === 0 && 'is-on']} data-fx-label data-kind={g.name}><b>{pad(gi + 1)}</b>{g.name}{g.items[0].color && <span data-fx-color> · {g.items[0].color}</span>}</p>
                ))}
              </div>
              <div class="fd-cap-count">
                {groups.length > 1 && <button type="button" class="fd-arrow" data-fx-prev aria-label="이전 원단">←</button>}
                <p aria-hidden="true"><span data-fx-now>01</span> / {pad(groups.length)}</p>
                {groups.length > 1 && <button type="button" class="fd-arrow" data-fx-next aria-label="다음 원단">→</button>}
              </div>
            </div>
            {groups.some((g) => g.items.length > 1) && (
              <div class="fd-dots">
                {groups.map((g, gi) => g.items.length > 1 && (
                  <div class:list={['fd-dot-row', gi === 0 && 'is-on']} data-fx-dots={gi}>
                    {g.items.map((w, ci) => (
                      <button type="button" class:list={['fd-dot', ci === 0 && 'is-on']} style={`--dot: ${w.base}`} data-fx-dot={ci} data-color={w.color} aria-label={`${w.color} 컬러 보기`} aria-pressed={ci === 0 ? 'true' : 'false'}></button>
                    ))}
                  </div>
                ))}
              </div>
            )}
            <div class="fd-bar" aria-hidden="true"><i data-fx-bar style={`transform: scaleX(${1 / groups.length})`}></i></div>
          </>
        )}
      </div>

      <div data-reveal style="--reveal-delay: 100ms">
        <p class="fd-eyebrow">{F.en.toUpperCase()}</p>
        <h2 class="fd-title">{F.title}</h2>
        <p class="fd-desc">{F.desc}</p>
        <dl class="fd-specs">
          {F.specs.map((s) => (
            <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
          ))}
        </dl>
        <p class="fd-cases-h">개발 사례</p>
        <ul>
          {F.cases.map((c, i) => {
            const kind = c.type === '우븐' ? 'woven' : 'knit';
            return (
              <li class="fd-case" data-case={c.name}>
                <span class="fd-case-no">{pad(i + 1)}</span>
                <div>
                  <p class="fd-case-name">{c.name}</p>
                  <p class="fd-case-desc">{c.desc}</p>
                </div>
                <span class="fd-case-kind">{kindEn(kind)}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* 왼쪽 글(5) · 오른쪽 사진(6). 휴대폰 · 태블릿은 사진이 위 */
  .fd-grid { display: grid; gap: 40px; }
  .fd-photo-col { order: -1; }
  @media (min-width: 1024px) {
    .fd-grid { grid-template-columns: 5fr 6fr; gap: 72px; align-items: center; }
    /* 사진 + 캡션이 한 화면에 들어오게 (헤더 · 캡션 자리 빼고) */
    .fd-photo-col { order: 2; width: 100%; max-width: min(460px, calc((100svh - 300px) * 0.8)); justify-self: end; }
  }

  /* ---- 원단 사진: 각진 칸, 여러 장이면 천천히 겹쳐 바뀜 ---- */
  .fd-photo { position: relative; aspect-ratio: 4 / 3.6; overflow: hidden; background: #faf6ee; }
  @media (min-width: 1024px) { .fd-photo { aspect-ratio: 4 / 5; } }
  .fd-photo > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fd-shot { opacity: 0; transform: scale(1.02); transition: opacity 1.4s ease; }
  .fd-shot.is-on { opacity: 1; animation: fd-zoom 6s linear both; }
  @keyframes fd-zoom { from { transform: scale(1.02); } to { transform: scale(1.1); } }
  /* 잔무늬 원단은 확대하지 않음 (무늬가 일렁여 눈이 아픔) */
  .fd-shot.is-still, .fd-shot.is-still.is-on { transform: none; animation: none; }

  /* 사진 아래 캡션 · 진행선 */
  .fd-cap { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 14px; font-size: 11px; font-weight: 600; letter-spacing: 0.16em; color: var(--color-muted); }
  .fd-cap-names { position: relative; flex: 1; min-height: 1.4em; }
  .fd-cap-name { position: absolute; left: 0; top: 0; opacity: 0; transform: translateY(6px); transition: opacity 0.5s ease, transform 0.5s ease; white-space: nowrap; }
  .fd-cap-name.is-on { opacity: 1; transform: none; transition-delay: 0.3s; }
  .fd-cap-name b { margin-right: 8px; color: var(--color-ink); }
  .fd-cap-count { display: flex; align-items: baseline; gap: 14px; font-variant-numeric: tabular-nums; }
  .fd-cap-count span { color: var(--color-ink); }
  .fd-arrow { font-size: 14px; line-height: 1; color: var(--color-ink); padding: 4px 2px; cursor: pointer; transition: color 0.2s, transform 0.2s; }
  .fd-arrow:hover { color: var(--color-accent); }
  [data-fx-prev]:hover { transform: translateX(-2px); }
  [data-fx-next]:hover { transform: translateX(2px); }
  .fd-photo.is-click { cursor: pointer; }
  .fd-case.is-click { cursor: pointer; }
  .fd-case.is-click:hover .fd-case-name { color: var(--color-accent); }
  /* 같은 원단의 컬러 점: 지금 원단에 컬러가 여러 개일 때만 보임. 자리는 늘 잡아 둬서 들썩이지 않음 */
  .fd-dots { position: relative; height: 22px; margin-top: 10px; }
  .fd-dot-row { position: absolute; left: 0; top: 0; display: flex; gap: 10px; opacity: 0; visibility: hidden; transition: opacity 0.4s ease, visibility 0.4s; }
  .fd-dot-row.is-on { opacity: 1; visibility: visible; transition-delay: 0.3s; }
  .fd-dot { width: 14px; height: 14px; margin: 4px; border-radius: 50%; background: var(--dot); cursor: pointer; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08); transition: box-shadow 0.25s, transform 0.25s; }
  .fd-dot:hover { transform: scale(1.12); }
  .fd-dot.is-on { box-shadow: 0 0 0 2px var(--color-paper, #f5efe4), 0 0 0 3px var(--color-ink); }
  .fd-bar { margin-top: 12px; height: 1px; background: var(--color-line); }
  .fd-bar i { display: block; height: 100%; background: var(--color-ink); transform-origin: 0 50%; transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  @media (prefers-reduced-motion: reduce) { .fd-shot.is-on { animation: none; } .fd-shot { transition: none; } }

  /* ---- 글: 제작 아카이브와 같은 제목 크기 ---- */
  .fd-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.28em; color: var(--color-accent); }
  .fd-title { margin-top: 18px; font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.05; }
  .fd-desc { margin-top: 20px; font-size: 15px; line-height: 1.75; color: var(--color-muted); }
  @media (min-width: 640px) { .fd-desc { font-size: 16px; } }

  /* 조건 표: 위 진한 선, 가운데 세로선 */
  .fd-specs { display: grid; grid-template-columns: 1fr 1fr; margin-top: 40px; border-top: 1px solid var(--color-ink); }
  .fd-specs > div { padding: 18px 0; border-bottom: 1px solid var(--color-line); }
  .fd-specs > div + div { padding-left: 24px; border-left: 1px solid var(--color-line); }
  .fd-specs dt { font-size: 12px; font-weight: 600; color: var(--color-muted); }
  .fd-specs dd { margin-top: 6px; font-size: clamp(1.125rem, 1.8vw, 1.375rem); font-weight: 600; letter-spacing: -0.03em; }

  /* 개발 사례: 번호 · 이름/설명 · 종류, 선으로 나눔. 지금 사진과 다른 종류는 옅게 */
  .fd-cases-h { margin-top: 36px; margin-bottom: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.2em; color: var(--color-muted); }
  .fd-case { display: grid; grid-template-columns: 28px 1fr auto; gap: 12px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--color-line); transition: opacity 0.5s; }
  [data-fabric].is-live .fd-case:not(.is-on) { opacity: 0.35; }
  .fd-case-no { font-size: 12px; font-weight: 600; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .fd-case-name { font-size: 16px; font-weight: 600; }
  .fd-case-desc { margin-top: 3px; font-size: 13px; color: var(--color-muted); }
  .fd-case-kind { font-size: 11px; font-weight: 600; letter-spacing: 0.16em; color: var(--color-muted); }
</style>

<script>
  // 원단 사진: 누르면 다음 사진으로 천천히 겹쳐 바뀜. 캡션 · 번호 · 진행선 · 사례 줄이 같이 바뀜
  const root = document.querySelector<HTMLElement>('[data-fabric]');
  const shots = [...(root?.querySelectorAll<HTMLElement>('[data-fx-shot]') ?? [])];
  if (root && shots.length) {
    // 이름이 같은 원단은 한 묶음(g). 묶음 안의 컬러(c)는 색 점으로 바꿈
    const labels = [...root.querySelectorAll<HTMLElement>('[data-fx-label]')];
    const dotRows = [...root.querySelectorAll<HTMLElement>('[data-fx-dots]')];
    const now = root.querySelector<HTMLElement>('[data-fx-now]');
    const bar = root.querySelector<HTMLElement>('[data-fx-bar]');
    const cases = [...root.querySelectorAll<HTMLElement>('[data-case]')];
    const total = labels.length;
    let g = 0;
    let c = 0;
    const show = (k: number, color = 0) => {
      g = (k + total) % total;
      c = color;
      shots.forEach((s) => s.classList.toggle('is-on', s.dataset.g === String(g) && s.dataset.c === String(c)));
      labels.forEach((l, i) => l.classList.toggle('is-on', i === g));
      dotRows.forEach((row) => {
        const on = row.dataset.fxDots === String(g);
        row.classList.toggle('is-on', on);
        row.querySelectorAll<HTMLElement>('[data-fx-dot]').forEach((d) => {
          const sel = on && d.dataset.fxDot === String(c);
          d.classList.toggle('is-on', d.dataset.fxDot === String(on ? c : 0));
          d.setAttribute('aria-pressed', sel ? 'true' : 'false');
          // 캡션의 색 이름도 같이 바뀜
          if (sel) { const span = labels[g].querySelector('[data-fx-color]'); if (span) span.textContent = ` · ${d.dataset.color}`; }
        });
      });
      if (now) now.textContent = String(g + 1).padStart(2, '0');
      if (bar) bar.style.transform = `scaleX(${(g + 1) / total})`;
      root.classList.add('is-live');
      cases.forEach((el) => el.classList.toggle('is-on', el.dataset.case === labels[g].dataset.kind));
    };
    show(0);
    // 색 점: 같은 원단 안에서 컬러만 바꿈
    dotRows.forEach((row) => row.querySelectorAll<HTMLElement>('[data-fx-dot]').forEach((d) => {
      d.addEventListener('click', () => show(Number(row.dataset.fxDots), Number(d.dataset.fxDot)));
    }));
    // 자동으로 넘어가지 않고, 누를 때만 바뀜: 사진 누르기 · ← → 버튼 · 개발 사례 줄 누르기(같은 원단으로)
    if (total > 1) {
      const photo = root.querySelector<HTMLElement>('[data-fx-photo]');
      photo?.classList.add('is-click');
      photo?.addEventListener('click', () => show(g + 1));
      root.querySelector('[data-fx-prev]')?.addEventListener('click', () => show(g - 1));
      root.querySelector('[data-fx-next]')?.addEventListener('click', () => show(g + 1));
      cases.forEach((el) => {
        const k = labels.findIndex((l) => l.dataset.kind === el.dataset.case);
        if (k < 0) return;
        el.classList.add('is-click');
        el.addEventListener('click', () => show(k));
      });
    }
  }
</script>
