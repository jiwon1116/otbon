---
import { nav, site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/70">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div>
        <a href="/" class="text-2xl font-extrabold tracking-tight text-white">{site.name}<span class="text-accent">.</span></a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed">기획부터 생산까지, 옷 만드는 일을 한 곳에서.</p>
      </div>

      <div class="grid grid-cols-2 gap-10 text-sm sm:grid-cols-3">
        <div>
          <p class="mb-3 font-semibold text-white">메뉴</p>
          <ul class="space-y-2">
            {nav.map((item) => <li><a href={item.href} class="hover:text-white">{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="mb-3 font-semibold text-white">문의</p>
          <ul class="space-y-2">
            <li><a href="/contact" class="hover:text-white">견적 문의</a></li>
            <li><a href={site.kakaoChannel} target="_blank" rel="noopener" class="hover:text-white">카카오톡 채널</a></li>
            <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs sm:flex-row sm:justify-between">
      <p>© {year} {site.name}. All rights reserved.</p>
      <a href="/privacy" class="hover:text-white">개인정보처리방침</a>
    </div>
  </div>
</footer>
