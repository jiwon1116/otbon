---
import { nav, site } from '../../data/site';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header
  id="site-header"
  data-transparent={transparent ? 'true' : 'false'}
  data-tone="light"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:h-20 lg:px-8">
    <a href="/" class="text-2xl font-extrabold tracking-tight">{site.name}<span class="text-accent">.</span></a>

    <nav class="hidden items-center gap-10 md:flex" aria-label="주요 메뉴">
      {nav.map((item) => (
        <a href={item.href} class="text-[15px] font-medium opacity-80 transition-opacity hover:opacity-100">
          {item.label}
        </a>
      ))}
      <a
        href="/contact"
        class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-dark"
      >
        견적 문의
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 p-2 md:hidden"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-paper text-ink md:hidden">
    <nav class="flex flex-col px-4 py-4" aria-label="모바일 메뉴">
      {nav.map((item) => (
        <a href={item.href} class="py-3 text-lg font-medium">{item.label}</a>
      ))}
      <a href="/contact" class="mt-3 rounded-full bg-accent py-3 text-center font-semibold text-white">견적 문의</a>
    </nav>
  </div>
</header>

<style>
  #site-header {
    background: var(--color-paper);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  #site-header[data-transparent='true']:not(.is-solid) {
    background: transparent;
    color: #fff;
    border-bottom-color: transparent;
  }
  /* 스크롤 히어로의 흰 배경 위에선 검은 글자. 영상이 꽉 차면 히어로가 data-tone="dark"로 바꿈 */
  :global(.motion) #site-header[data-transparent='true'][data-tone='light']:not(.is-solid) {
    color: var(--color-ink);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  let menuOpen = false;

  // 히어로가 있으면 히어로를 다 지나간 뒤에 흰 헤더로 바뀜
  const update = () => {
    const passed = hero ? hero.getBoundingClientRect().bottom <= header.offsetHeight : window.scrollY > 40;
    header.classList.toggle('is-solid', menuOpen || passed);
  };

  toggle.addEventListener('click', () => {
    menuOpen = !menuOpen;
    menu.classList.toggle('hidden', !menuOpen);
    toggle.setAttribute('aria-expanded', String(menuOpen));
    toggle.setAttribute('aria-label', menuOpen ? '메뉴 닫기' : '메뉴 열기');
    update();
  });

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
