---
import { nav, site } from '../../data/site';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header
  id="site-header"
  data-transparent={transparent ? 'true' : 'false'}
  data-tone="light"
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-[color,background-color,border-color,transform] duration-300',
    // 히어로가 있는 첫 화면은 처음부터 숨긴 채로 그림 (JS가 돌기 전 헤더가 잠깐 보였다 사라지는 깜빡임 방지)
    transparent && 'is-hero-hidden',
  ]}
>
  <!-- 로고(왼쪽) · 메뉴(가운데) · 견적 문의(오른쪽) -->
  <div class="mx-auto grid h-16 max-w-7xl grid-cols-[1fr_auto] items-center px-4 sm:px-6 md:grid-cols-[1fr_auto_1fr] lg:h-20 lg:px-8">
    <!-- 가로형 로고. 그림을 글자색(currentColor)으로 칠해서, 영상 위 흰 헤더 · 베이지 헤더 어디서든 글자색을 따라감 -->
    <a href="/#home" class="justify-self-start" aria-label={`${site.name} 홈`}>
      <span class="brand-mark block h-7 bg-current lg:h-8" aria-hidden="true"></span>
    </a>

    <nav class="hidden items-center gap-8 md:flex lg:gap-12" aria-label="주요 메뉴">
      {nav.map((item) =>
        item.children ? (
          <div class="nav-drop">
            <a href={item.href} class="nav-drop-link relative text-[15px] font-medium opacity-80 transition-opacity hover:opacity-100">
              {item.label}
            </a>
            <div class="nav-sub absolute inset-x-0 top-full border-b border-line bg-paper text-ink">
              <div class="mx-auto grid max-w-7xl grid-cols-12 gap-8 px-4 py-10 sm:px-6 lg:px-8">
                <div class="col-span-3">
                  <p class="text-[11px] font-semibold tracking-[0.3em] text-accent">{item.en}</p>
                  <p class="mt-3 text-2xl font-semibold">{item.label}</p>
                </div>
                <ul class="col-span-9 grid grid-cols-3 gap-4">
                  {item.children.map((c, i) => (
                    <li class="nav-sub-item" style={`--i:${i}`}>
                      <a href={c.href} class="group block border-t border-ink/15 pt-5 transition-colors hover:border-accent">
                        <span class="flex items-center justify-between">
                          <span class="text-lg font-semibold transition-colors group-hover:text-accent">{c.label}</span>
                          <svg class="h-4 w-4 -translate-x-1 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 group-hover:text-accent" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </span>
                        <span class="mt-2 block text-sm text-muted">{c.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class="text-[15px] font-medium opacity-80 transition-opacity hover:opacity-100">
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="hidden justify-self-end md:block">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-dark"
      >
        견적 문의
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 justify-self-end p-2 md:hidden"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- 메뉴가 열리면 세 줄이 X 로 바뀜 -->
      <span class="mm-burger" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <!-- 휴대폰 메뉴: 헤더 아래 화면 전체를 덮는 판. 메뉴마다 이름 · 영어, 하위 메뉴는 그 아래 작은 칸으로
       아래쪽에 견적 문의 버튼과 연락처. 열릴 때 항목이 차례로 떠오름 -->
  <div id="mobile-menu" class="mm hidden md:hidden" data-v="a">
    <nav class="mm-inner" aria-label="모바일 메뉴">
      <ul class="mm-list">
        {nav.map((item, i) => (
          <li class="mm-group" style={`--i:${i}`}>
            <a href={item.href} class="mm-main">
              <span class="mm-label">{item.label}</span>
              <span class="mm-en">{item.en}</span>
              <svg class="mm-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            {item.children && (
              <ul class="mm-subs">
                {item.children.map((c) => (
                  <li><a href={c.href} class="mm-sub">{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="mm-foot" style={`--i:${nav.length}`}>
        <a href="#contact" class="mm-cta">견적 문의<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <div class="mm-contact">
          <a href={`tel:${site.company.phone}`}>{site.company.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  /* 헤더 로고: public/images/brand/logo-horizontal.svg 모양대로 글자색을 오려냄 (비율은 SVG viewBox 그대로) */
  .brand-mark {
    aspect-ratio: 194.02 / 44.92;
    -webkit-mask: url('/images/brand/logo-horizontal.svg') center / contain no-repeat;
    mask: url('/images/brand/logo-horizontal.svg') center / contain no-repeat;
  }

  /* 하위 메뉴: 헤더 아래로 화면 폭 전체 패널이 내려옴. 메뉴에 마우스를 올리거나 키보드로 들어가면 보임 */
  .nav-sub {
    opacity: 0;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    box-shadow: 0 24px 40px -32px rgb(10 10 10 / 0.35);
    transition: clip-path 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s, visibility 0.45s;
  }
  .nav-drop:hover .nav-sub,
  .nav-drop:focus-within .nav-sub { opacity: 1; visibility: visible; clip-path: inset(0 0 -60px 0); }
  /* 항목은 패널이 내려온 뒤 차례로 살짝 떠오름 */
  .nav-sub-item { opacity: 0; transform: translateY(8px); transition: opacity 0.4s, transform 0.4s; }
  .nav-drop:hover .nav-sub-item,
  .nav-drop:focus-within .nav-sub-item { opacity: 1; transform: none; transition-delay: calc(120ms + var(--i) * 70ms); }
  /* 메뉴 글씨에서 패널까지 마우스가 내려가는 동안 끊기지 않게 보이지 않는 다리를 놓음 */
  .nav-drop-link::after { content: ''; position: absolute; left: -24px; right: -24px; top: 100%; height: 40px; }
  /* 열린 메뉴 아래 밑줄 */
  .nav-drop-link::before { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 1.5px; background: currentColor; transform: scaleX(0); transition: transform 0.3s; }
  .nav-drop:hover .nav-drop-link::before { transform: scaleX(1); }
  /* 패널이 열리면 영상 위 투명 헤더도 베이지 바탕으로 */
  #site-header[data-transparent=true]:has(.nav-drop:hover, .nav-drop:focus-within) {
    background: var(--color-paper);
    color: var(--color-ink);
    border-bottom-color: var(--color-line);
  }
  @media (prefers-reduced-motion: reduce) { .nav-sub, .nav-sub-item { transition: none; } }

  #site-header {
    background: var(--color-paper);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  #site-header[data-transparent='true']:not(.is-solid) {
    background: transparent;
    color: #fff;
    border-bottom-color: transparent;
  }
  /* 지도 섹션이 화면을 덮는 동안엔 헤더를 위로 숨김 */
  /* 첫 화면(히어로 로고)에서도 숨김. 히어로 스크립트가 붙였다 뗌 */
  #site-header.is-hidden { transform: translateY(-100%); }
  /* 움직임 모드에서만 (움직임 없는 환경에선 히어로 연출이 없으니 헤더를 그대로 보여줌) */
  :global(.motion) #site-header.is-hero-hidden { transform: translateY(-100%); }
  /* 스크롤 히어로의 흰 배경 위에선 검은 글자. 영상이 꽉 차면 히어로가 data-tone="dark"로 바꿈 */
  :global(.motion) #site-header[data-transparent='true'][data-tone='light']:not(.is-solid) {
    color: var(--color-ink);
  }

  /* ───── 휴대폰 메뉴 ───── */
  .mm-burger { position: relative; display: block; width: 22px; height: 16px; }
  .mm-burger i { position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.2s, top 0.35s; }
  .mm-burger i:nth-child(1) { top: 0; }
  .mm-burger i:nth-child(2) { top: 7px; }
  .mm-burger i:nth-child(3) { top: 14px; }
  [aria-expanded='true'] .mm-burger i:nth-child(1) { top: 7px; transform: rotate(45deg); }
  [aria-expanded='true'] .mm-burger i:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .mm-burger i:nth-child(3) { top: 7px; transform: rotate(-45deg); }

  .mm { position: fixed; left: 0; right: 0; top: 4rem; bottom: 0; overflow-y: auto; background: var(--color-paper); color: var(--color-ink); }
  .mm-inner { display: flex; min-height: 100%; flex-direction: column; padding: 12px 20px 28px; }
  .mm-list { flex: 1; }
  .mm-group { border-bottom: 1px solid rgb(40 40 40 / 0.1); }
  .mm-main { display: grid; grid-template-columns: 1fr auto 1rem; align-items: center; gap: 8px; padding: 22px 0; }
  .mm-num { font-size: 12px; font-weight: 600; color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .mm-label { font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
  .mm-en { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; color: var(--color-muted); }
  .mm-arrow { width: 16px; height: 16px; color: var(--color-accent); }
  .mm-subs { display: flex; flex-wrap: wrap; gap: 8px; margin: -6px 0 20px; }
  .mm-sub { display: inline-block; padding: 8px 16px; border-radius: 999px; background: #faf6ee; box-shadow: inset 0 0 0 1px rgb(40 40 40 / 0.08); font-size: 14px; font-weight: 500; }
  .mm-foot { margin-top: 28px; }
  .mm-cta { display: flex; align-items: center; justify-content: space-between; padding: 18px 24px; border-radius: 999px; background: var(--color-accent); color: #f5f1e8; font-weight: 600; }
  .mm-cta svg { width: 18px; height: 18px; }
  .mm-contact { display: flex; justify-content: center; gap: 16px; margin-top: 16px; font-size: 13px; color: var(--color-muted); }

  /* 시안 B: 진한 초록 판 + 베이지 글씨 */
  .mm[data-v='b'] { background: var(--color-accent); color: #f5f1e8; }
  .mm[data-v='b'] .mm-group { border-color: rgb(245 241 232 / 0.16); }
  .mm[data-v='b'] :is(.mm-num, .mm-arrow) { color: #c9dccf; }
  .mm[data-v='b'] .mm-en { color: rgb(245 241 232 / 0.55); }
  .mm[data-v='b'] .mm-sub { background: rgb(245 241 232 / 0.1); box-shadow: inset 0 0 0 1px rgb(245 241 232 / 0.18); }
  .mm[data-v='b'] .mm-cta { background: #f5f1e8; color: var(--color-accent); }
  .mm[data-v='b'] .mm-contact { color: rgb(245 241 232 / 0.6); }

  /* 시안 C: 메뉴마다 카드 (2칸 바둑판, 첫 칸은 초록 넓게), 하위 메뉴는 카드 안 작은 칸 */
  .mm[data-v='c'] .mm-list { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-content: start; padding-top: 8px; }
  .mm[data-v='c'] .mm-group { border: 0; border-radius: 22px; background: #faf6ee; padding: 18px; display: flex; flex-direction: column; min-height: 150px; }
  .mm[data-v='c'] .mm-group:last-child { grid-column: 1 / -1; min-height: 120px; }
  .mm[data-v='c'] .mm-group:first-child { grid-column: 1 / -1; background: var(--color-accent); color: #f5f1e8; }
  .mm[data-v='c'] .mm-group:first-child :is(.mm-num, .mm-arrow) { color: #c9dccf; }
  .mm[data-v='c'] .mm-group:first-child .mm-en { color: rgb(245 241 232 / 0.6); }
  .mm[data-v='c'] .mm-main { display: flex; flex-direction: column; align-items: flex-start; gap: 0; padding: 0; flex: 1; position: relative; }
  .mm[data-v='c'] .mm-en { order: 1; margin-top: auto; padding-top: 28px; }
  .mm[data-v='c'] .mm-label { order: 2; margin-top: 4px; font-size: 22px; }
  .mm[data-v='c'] .mm-arrow { position: absolute; top: 0; right: 0; }
  .mm[data-v='c'] .mm-subs { margin: 14px 0 0; }
  .mm[data-v='c'] .mm-group:first-child .mm-sub { background: rgb(245 241 232 / 0.12); box-shadow: inset 0 0 0 1px rgb(245 241 232 / 0.2); }

  /* 열릴 때: 판이 위에서 펼쳐지고, 항목이 차례로 떠오름 */
  .mm:not(.hidden) { animation: mm-in 0.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .mm:not(.hidden) :is(.mm-group, .mm-foot) { animation: mm-item 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(80ms + var(--i) * 60ms); }
  @keyframes mm-in { from { opacity: 0; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes mm-item { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .mm:not(.hidden), .mm:not(.hidden) :is(.mm-group, .mm-foot) { animation: none; } }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const map = document.querySelector<HTMLElement>('[data-network]');
  // 히어로가 없는 페이지면 첫 화면 숨김을 풀어둠
  if (!hero) header.classList.remove('is-hero-hidden');
  let menuOpen = false;

  // 히어로가 있으면, 히어로 연출이 끝나 화면 위로 밀려 올라가기 시작할 때 흰 헤더로 바뀜
  // (투명 헤더가 올라가는 제목 글씨와 겹치지 않게)
  const update = () => {
    const passed = hero ? hero.getBoundingClientRect().bottom <= window.innerHeight + 1 : window.scrollY > 40;
    header.classList.toggle('is-solid', menuOpen || passed);
    // 지도 섹션이 화면 맨 위에 닿아 있는 동안엔 헤더를 숨김 (메뉴가 열려 있으면 그대로)
    const r = map?.getBoundingClientRect();
    const onMap = !!r && r.top <= header.offsetHeight && r.bottom > header.offsetHeight;
    header.classList.toggle('is-hidden', onMap && !menuOpen);
  };

  toggle.addEventListener('click', () => {
    menuOpen = !menuOpen;
    menu.classList.toggle('hidden', !menuOpen);
    toggle.setAttribute('aria-expanded', String(menuOpen));
    toggle.setAttribute('aria-label', menuOpen ? '메뉴 닫기' : '메뉴 열기');
    document.documentElement.style.overflow = menuOpen ? 'hidden' : '';
    update();
  });
  // 메뉴 안 링크를 누르면 닫힘 (같은 페이지 안 이동일 때도)
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { if (menuOpen) toggle.click(); }));

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
