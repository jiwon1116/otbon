---
import Layout from '../layouts/Layout.astro';
import Standards from '../components/sections/home/Standards.astro';
import ProcessSteps from '../components/sections/home/ProcessSteps.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { standards as S } from '../data/site';

// 첫 화면 바로가기 버튼: [위치, 영어, 한글]
const jump = [
  ['#process', 'Process', '제작 과정'],
  ['#quote', S.quote.en, S.quote.title],
  ['#prepare', S.prepare.en, S.prepare.title],
];
---

<!--
  제작 기준 페이지 (메뉴 '제작 기준'). 문구는 src/data/site.ts 의 standards · process
  첫 화면 제목 → 제작 과정 → 견적 기준 → 상담 준비 자료 → 견적 문의
-->
<Layout title="제작 기준" description="옷본의 제작 과정과 견적이 정해지는 기준, 견적 상담 전 준비 자료를 안내합니다.">
  <!-- 첫 화면: 가운데 큰 제목 + 설명 + 아래 세 부분으로 바로 가는 버튼 (아래 섹션 제목들과 구분되게 가운데 정렬) -->
  <section class="mx-auto max-w-7xl px-4 pb-24 pt-28 sm:px-6 lg:px-8 lg:pb-32">
    <p class="text-sm text-muted" data-reveal>
      <a href="/" class="transition-colors hover:text-ink">홈</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-ink">제작 기준</span>
    </p>
    <div class="mx-auto mt-16 max-w-3xl text-center lg:mt-20" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">{S.eyebrow}</p>
      <h1 class="mt-6 text-5xl font-bold tracking-tight sm:text-7xl">{S.title.join(' ')}</h1>
      <p class="mx-auto mt-7 max-w-xl leading-relaxed text-muted sm:text-lg">{S.lead}</p>
    </div>
    <ol class="st-jumps mx-auto mt-14 grid max-w-3xl grid-cols-1 overflow-hidden md:grid-cols-3 md:gap-px md:rounded-3xl md:bg-line" data-reveal style="--reveal-delay: 120ms">
      {jump.map(([href, en, ko], i) => (
        <li>
          <a href={href} class="st-jump">
            <span class="st-num text-xs font-semibold tabular-nums text-accent">{String(i + 1).padStart(2, '0')}</span>
            <span class="st-en mt-6 block text-[11px] uppercase tracking-[0.2em] text-muted">{en}</span>
            <span class="st-ko mt-1 block font-semibold">{ko}</span>
            <svg class="st-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- 세 챕터: 큰 화면에선 한 화면에 한 챕터씩 보이게 높이를 맞춤 -->
  <div class="st-chapters">
    <ProcessSteps />
    <Standards part="quote" />
    <Standards part="prepare" />
  </div>

  <CtaSection />
</Layout>

<style>
  /* 큰 화면: 챕터마다 최소 화면 높이(헤더 제외)만큼 차지해서 다음 챕터가 같이 보이지 않게 */
  @media (min-width: 1024px) {
    .st-chapters > :global(section) { display: flex; align-items: center; min-height: calc(100svh - 5rem); }
    .st-chapters > :global(section) > :global(div) { width: 100%; padding-top: 5rem; padding-bottom: 5rem; }
  }

  /* 바로가기 칸: 마우스를 올리면 초록 */
  .st-jump { display: block; height: 100%; padding: 22px 22px 24px; background: #faf6ee; transition: background-color 0.3s ease, color 0.3s ease; }
  .st-jump:hover { background: var(--color-accent); color: #f5f1e8; }
  .st-jump:hover span { color: inherit; }
  .st-arrow { display: none; }

  /* 휴대폰: 칸 대신 가는 선으로 나눈 목록 (한글 이름 · 영어 · 아래 화살표) */
  @media (max-width: 767px) {
    .st-jumps { border-top: 1px solid rgb(40 40 40 / 0.15); }
    .st-jump { display: grid; grid-template-columns: 1fr auto 1rem; align-items: center; gap: 12px; padding: 18px 2px; background: transparent; border-bottom: 1px solid rgb(40 40 40 / 0.1); }
    .st-jump:hover { background: transparent; color: var(--color-accent); }
    .st-num { display: none; }
    .st-ko { order: 1; margin: 0; font-size: 17px; }
    .st-en { order: 2; margin: 0; font-size: 10px; }
    .st-arrow { order: 3; display: block; width: 16px; height: 16px; color: var(--color-accent); }
  }
</style>
