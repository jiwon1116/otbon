---
import Layout from '../layouts/Layout.astro';
import BrandLogo from '../components/ui/BrandLogo.astro';
import BrandStory from '../components/sections/brand/BrandStory.astro';
import { brandStory } from '../data/site';

---

<!--
  CI 페이지 (회사소개 > CI)
  1) 첫 화면: 왼쪽 제목 · 소개 · 목차, 오른쪽 로고 판 (#logo)
  3) 02 Symbol: 초록 실이 심볼을 그리며 의미 풀이 (BrandStory, 브랜드 이야기도 여기에 담음)
  4) 03 Color: 브랜드 컬러 3가지 (겹친 원 + 목록)
  5) 맺음말
-->
<Layout title="CI" description="옷본(OTBON)의 로고와 심볼에 담긴 의미를 소개합니다.">
  <section id="logo" class="mx-auto max-w-7xl px-4 pb-24 pt-28 sm:px-6 lg:px-8 lg:pb-36 lg:pt-28">
    <p class="text-sm text-muted" data-reveal>
      <a href="/#about" class="transition-colors hover:text-ink">회사소개</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-ink">CI</span>
    </p>
    <div class="mt-6 grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="ci-eyebrow">Corporate Identity</p>
        <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">OTBON<br />브랜드 아이덴티티</h1>
        <p class="mt-6 max-w-md leading-relaxed text-muted">옷본의 로고와 심볼, 브랜드 컬러를 소개합니다. 실 한 가닥에서 시작해 세계를 잇는 의류 제작 기업의 정체성을 담았습니다.</p>
        <!-- 페이지 목차 -->
        <ul class="mt-10 space-y-1 border-t border-ink/15 pt-5 text-sm">
          <li><a href="#logo" class="ci-toc"><span>01</span>로고</a></li>
          <li><a href="#symbol" class="ci-toc"><span>02</span>심볼에 담긴 의미</a></li>
          <li><a href="#color" class="ci-toc"><span>03</span>브랜드 컬러</a></li>
        </ul>
      </div>
      <!-- 로고 판 (화면에 들어오면 심볼이 그어짐) -->
      <figure class="ci-stage ci-stage-hero lg:col-span-7" data-reveal style="--reveal-delay: 100ms"><BrandLogo class="aspect-square max-w-[200px] sm:max-w-[260px] lg:max-w-[300px]" animate fill="currentColor" /></figure>
    </div>
  </section>

  <!-- 3) 심볼 풀이 -->
  <BrandStory />

  <!-- 4) 브랜드 컬러: 왼쪽 겹친 원 세 개, 오른쪽 이름 · 설명 · HEX -->
  <section id="color" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div data-reveal>
      <p class="ci-eyebrow"><span>03</span>Color</p>
      <h2 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">브랜드 컬러</h2>
    </div>
    <div class="mt-12 grid items-center gap-12 lg:grid-cols-12">
      <div class="flex justify-center lg:col-span-6" data-reveal>
        {brandStory.colors.map((c, i) => (
          <span class="h-32 w-32 rounded-full sm:h-44 sm:w-44" style={`background:${c.hex}; margin-left:${i ? '-2.25rem' : '0'}; ${c.dark ? '' : 'box-shadow: inset 0 0 0 1px #e2d9c9'}`}></span>
        ))}
      </div>
      <ul class="space-y-5 lg:col-span-5 lg:col-start-8">
        {brandStory.colors.map((c) => (
          <li class="flex items-start gap-4">
            <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full" style={`background:${c.hex}; box-shadow: inset 0 0 0 1px rgb(40 40 40 / 0.15)`}></span>
            <div>
              <p class="font-semibold">{c.name} <span class="ml-1 text-sm font-normal text-muted">{c.ko}</span></p>
              <p class="mt-0.5 text-sm text-muted">{c.desc}</p>
              <p class="mt-1.5 text-xs tabular-nums text-muted"><span class="font-semibold text-ink">{c.hex}</span></p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5) 맺음말 한 문장 -->
  <section class="px-4 pb-28 text-center lg:pb-40">
    <p class="mx-auto max-w-3xl text-2xl font-semibold leading-snug tracking-tight sm:text-4xl" data-reveal>{brandStory.closing}</p>
  </section>

</Layout>

<style is:global>

  /* 섹션 머리: 번호 + 영어 이름 */
  .ci-eyebrow { display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-accent); }
  .ci-eyebrow span { letter-spacing: 0; padding-right: 12px; border-right: 1px solid currentColor; }

  /* 첫 화면 오른쪽 로고 판: 휴대폰은 정사각, 큰 화면은 살짝 가로로 */
  .ci-stage-hero { aspect-ratio: 1 / 1 !important; }
  @media (min-width: 1024px) { .ci-stage-hero { aspect-ratio: 5 / 4 !important; } }

  /* 목차: 마우스를 올리면 초록 */
  .ci-toc { display: flex; gap: 1rem; padding: 0.35rem 0; transition: color 0.2s ease; }
  .ci-toc span { width: 1.5rem; font-weight: 600; color: var(--color-accent); }
  .ci-toc:hover { color: var(--color-accent); }

  /* 로고 판 */
  .ci-stage {
    position: relative; display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1 / 1; padding: 48px 24px; border-radius: 24px;
    background: #faf6ee; color: #282828;
  }
  @media (min-width: 768px) { .ci-stage { aspect-ratio: 16 / 8; } }



</style>

