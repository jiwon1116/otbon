---
import Layout from '../layouts/Layout.astro';
import BrandLogo from '../components/ui/BrandLogo.astro';
import BrandStory from '../components/sections/brand/BrandStory.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { brandStory } from '../data/site';

const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(' · ');
---

<!--
  CI 페이지 (회사소개 > CI)
  1) 큰 제목 Corporate Identity + 브랜드 이야기
  2) 01 Logo: 기본형(밝은 바탕) · 반전형(초록 바탕) 로고
  3) 02 Symbol: 초록 실이 심볼을 그리며 의미 풀이 (BrandStory)
  4) 03 Color: 브랜드 컬러 3가지
  5) 맺음말
-->
<Layout title="CI" description="옷본(OTBON)의 로고와 심볼에 담긴 의미를 소개합니다.">
  <!-- 1) 첫 화면 -->
  <section class="mx-auto max-w-7xl px-4 pb-20 pt-32 sm:px-6 lg:px-8 lg:pb-28 lg:pt-44">
    <p class="text-sm text-muted" data-reveal>
      <a href="/#about" class="transition-colors hover:text-ink">회사소개</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-ink">CI</span>
    </p>
    <h1 class="ci-title mt-8 font-extrabold" data-reveal style="--reveal-delay: 80ms">
      <span class="block">Corporate</span>
      <span class="block">Identity<span class="text-accent">.</span></span>
    </h1>
    <div class="mt-14 grid gap-8 border-t border-ink pt-10 lg:mt-20 lg:grid-cols-12" data-reveal style="--reveal-delay: 160ms">
      <h2 class="text-2xl font-bold leading-snug sm:text-3xl lg:col-span-5">
        {brandStory.title.map((line) => <span class="block">{line}</span>)}
      </h2>
      <div class="space-y-3 leading-relaxed text-muted sm:text-lg lg:col-span-6 lg:col-start-7">
        {brandStory.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- 2) 로고 -->
  <section id="logo" class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-36">
    <div data-reveal>
      <p class="ci-eyebrow"><span>01</span>Logo</p>
      <h2 class="mt-5 text-3xl font-bold sm:text-4xl">로고</h2>
    </div>

    <!-- 큰 판 하나. 아래 버튼으로 기본형(흰 바탕) ↔ 반전형(초록 바탕) 전환. 바뀔 때 심볼이 다시 그어짐 -->
    <div class="mt-10 lg:mt-14" data-logo-switch data-mode="primary">
      <figure class="ci-stage" data-reveal style="--reveal-delay: 80ms">
        <BrandLogo class="aspect-square max-w-[180px] sm:max-w-[240px] lg:max-w-[300px]" animate fill="currentColor" />
        <figcaption class="ci-stage-cap">
          <span data-cap="primary">밝은 바탕에 사용하는 기본형</span>
          <span data-cap="reverse">어두운 바탕에 사용하는 반전형</span>
        </figcaption>
      </figure>
      <div class="mt-6 flex justify-center" data-reveal style="--reveal-delay: 160ms">
        <div class="ci-toggle" role="tablist" aria-label="로고 바탕 선택">
          <button type="button" role="tab" data-to="primary" aria-selected="true">Primary</button>
          <button type="button" role="tab" data-to="reverse" aria-selected="false">Reverse</button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3) 심볼 풀이 -->
  <BrandStory />

  <!-- 4) 브랜드 컬러 -->
  <section id="color" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-36">
    <div data-reveal>
      <p class="ci-eyebrow"><span>03</span>Color</p>
      <h2 class="mt-5 text-3xl font-bold sm:text-4xl">브랜드 컬러</h2>
    </div>
    <ul class="mt-10 grid gap-4 md:grid-cols-3 lg:mt-14">
      {brandStory.colors.map((c, i) => (
        <li
          class:list={['ci-chip', c.dark ? 'text-white' : 'border border-line text-ink']}
          style={`background:${c.hex}; --reveal-delay:${i * 120}ms`}
          data-reveal
        >
          <div>
            <p class="text-2xl font-bold">{c.name}</p>
            <p class:list={['mt-1 text-sm', c.dark ? 'text-white/70' : 'text-muted']}>{c.ko}</p>
          </div>
          <div>
            <p class:list={['text-sm leading-relaxed', c.dark ? 'text-white/70' : 'text-muted']}>{c.desc}</p>
            <dl class:list={['mt-5 grid grid-cols-[3rem_1fr] gap-y-1 border-t pt-5 text-sm tabular-nums', c.dark ? 'border-white/20' : 'border-ink/15']}>
              <dt class="opacity-60">HEX</dt><dd class="font-semibold">{c.hex}</dd>
              <dt class="opacity-60">RGB</dt><dd class="font-semibold">{rgb(c.hex)}</dd>
            </dl>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- 5) 맺음말: 바늘땀 점선 아래 한 문장 -->
  <section class="px-4 pb-28 text-center lg:pb-40">
    <div class="ci-stitch mx-auto" aria-hidden="true"></div>
    <p class="mx-auto mt-10 max-w-3xl text-2xl font-bold leading-snug sm:text-4xl" data-reveal>{brandStory.closing}</p>
  </section>

  <CtaSection />
</Layout>

<style is:global>
  .ci-title { font-size: clamp(3.5rem, 13vw, 11.5rem); line-height: 0.92; letter-spacing: -0.045em; }

  /* 섹션 머리: 번호 + 영어 이름 */
  .ci-eyebrow { display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-accent); }
  .ci-eyebrow span { letter-spacing: 0; padding-right: 12px; border-right: 1px solid currentColor; }

  /* 로고 판: 큰 판 하나, 바탕 · 로고 색이 모드에 따라 부드럽게 바뀜 */
  .ci-stage {
    position: relative; display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1 / 1; padding: 48px 24px; border-radius: 24px;
    background: #fff; color: #282828;
    transition: background-color 0.6s ease, color 0.6s ease;
  }
  @media (min-width: 768px) { .ci-stage { aspect-ratio: 16 / 8; } }
  [data-mode='reverse'] .ci-stage { background: var(--color-accent); color: #fff; }
  .ci-stage-cap { position: absolute; left: 0; right: 0; bottom: 22px; text-align: center; font-size: 13px; opacity: 0.55; }
  .ci-stage-cap span { display: none; }
  [data-mode='primary'] .ci-stage-cap [data-cap='primary'],
  [data-mode='reverse'] .ci-stage-cap [data-cap='reverse'] { display: inline; }

  /* 전환 버튼: 둥근 알약 두 칸 */
  .ci-toggle { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--color-soft); }
  .ci-toggle button { padding: 8px 20px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--color-muted); transition: background-color 0.3s, color 0.3s; }
  .ci-toggle button[aria-selected='true'] { background: #fff; color: var(--color-ink); box-shadow: 0 1px 2px rgb(10 10 10 / 0.08); }
  .ci-toggle button[data-to='reverse'][aria-selected='true'] { background: var(--color-accent); color: #fff; }
  .ci-toggle button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* 컬러 칩: 위에 이름, 아래 값 */
  .ci-chip { display: flex; flex-direction: column; justify-content: space-between; gap: 56px; min-height: 340px; border-radius: 20px; padding: 32px; }

  /* 맺음말 위 세로 바늘땀 */
  .ci-stitch { width: 2px; height: 72px; background: repeating-linear-gradient(180deg, var(--color-accent) 0 8px, transparent 8px 14px); }
</style>

<script>
  // 로고 판 전환: 버튼을 누르면 data-mode 를 바꿔 바탕 · 로고 색을 바꾸고, 심볼 애니메이션을 처음부터 다시 재생
  document.querySelectorAll<HTMLElement>('[data-logo-switch]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-to]')];
    const replay = () => {
      root.querySelectorAll<SVGElement>('.logo-stripe, .logo-type').forEach((el) =>
        el.getAnimations().forEach((a) => { a.cancel(); a.play(); }),
      );
    };
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        const mode = tab.dataset.to!;
        if (root.dataset.mode === mode) return;
        root.dataset.mode = mode;
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        replay();
      }),
    );
  });
</script>
