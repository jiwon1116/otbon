---
import Layout from '../layouts/Layout.astro';
import ProductionGrid from '../components/sections/home/ProductionGrid.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { servicesIntro } from '../data/site';
---

<!--
  생산 분야 페이지 (메뉴 '생산 분야'). 문구는 src/data/site.ts 의 servicesIntro · services
  가운데 큰 제목(제작 기준 페이지와 같은 모양) → 공정별 생산 분야 6장 → 견적 문의
-->
<Layout title="생산 분야" description={servicesIntro.desc}>
  <section class="mx-auto max-w-7xl px-4 pb-16 pt-28 sm:px-6 lg:px-8 lg:pb-20">
    <p class="text-sm text-muted" data-reveal>
      <a href="/" class="transition-colors hover:text-ink">홈</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-ink">생산 분야</span>
    </p>
    <div class="mx-auto mt-16 max-w-3xl text-center lg:mt-20" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">{servicesIntro.eyebrow}</p>
      <h1 class="mt-6 text-5xl font-bold tracking-tight sm:text-7xl">생산 분야</h1>
      <p class="mx-auto mt-7 max-w-xl leading-relaxed text-muted sm:text-lg">{servicesIntro.desc}</p>
    </div>
  </section>

  <ProductionGrid hideHead />

  <CtaSection />
</Layout>
