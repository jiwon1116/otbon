---
import Layout from '../layouts/Layout.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaSection from '../components/CtaSection.astro';
import ScrollHero from '../components/ScrollHero.astro';
import { services, process, portfolio, testimonials, faqs } from '../data/site';
---

<Layout transparentHeader>
  <!-- 히어로: 스크롤하면 영상이 화면을 꽉 채움 -->
  <ScrollHero />

  <!-- 서비스 요약 -->
  <section id="services" class="mx-auto max-w-7xl scroll-mt-20 px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="text-sm font-semibold tracking-[0.2em] text-accent">SERVICES</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">어떤 옷이든 만듭니다</h2>
      </div>
      <a href="/services" class="text-sm font-semibold underline-offset-4 hover:underline">서비스 자세히 보기 →</a>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <div class="group bg-paper p-8 transition-colors hover:bg-ink hover:text-white" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
          <span class="text-sm font-semibold text-muted group-hover:text-accent">0{i + 1}</span>
          <h3 class="mt-10 text-2xl font-bold">{s.title}</h3>
          <p class="mt-1 text-sm text-muted group-hover:text-white/60">{s.en}</p>
          <p class="mt-6 leading-relaxed text-muted group-hover:text-white/80">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 제작 과정 4단계 -->
  <section class="bg-soft">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div data-reveal>
        <p class="text-sm font-semibold tracking-[0.2em] text-accent">PROCESS</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">4단계로 끝나는 제작 과정</h2>
      </div>

      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {process.map((p, i) => (
          <li class="border-t-2 border-ink pt-6" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <span class="text-4xl font-extrabold text-accent">{p.step}</span>
            <h3 class="mt-4 text-xl font-bold">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{p.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 포트폴리오 일부 -->
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="text-sm font-semibold tracking-[0.2em] text-accent">PORTFOLIO</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">최근 작업</h2>
      </div>
      <a href="/portfolio" class="text-sm font-semibold underline-offset-4 hover:underline">전체 포트폴리오 →</a>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:grid-cols-3">
      {portfolio.slice(0, 6).map((item, i) => (
        <div data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
          <PortfolioCard {...item} />
        </div>
      ))}
    </div>
  </section>

  <!-- 후기 -->
  <section class="border-y border-line">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div data-reveal>
        <p class="text-sm font-semibold tracking-[0.2em] text-accent">REVIEWS</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">고객이 남긴 이야기</h2>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {testimonials.map((t, i) => (
          <figure class="flex flex-col justify-between rounded-lg border border-line p-8" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <blockquote class="text-lg leading-relaxed">“{t.quote}”</blockquote>
            <figcaption class="mt-8 text-sm">
              <span class="font-semibold">{t.name}</span>
              <span class="text-muted"> · {t.org}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ 일부 -->
  <section class="mx-auto grid max-w-7xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-3 lg:px-8 lg:py-32">
    <div data-reveal>
      <p class="text-sm font-semibold tracking-[0.2em] text-accent">FAQ</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">자주 묻는 질문</h2>
      <a href="/faq" class="mt-6 inline-block text-sm font-semibold underline-offset-4 hover:underline">FAQ 전체 보기 →</a>
    </div>
    <div class="lg:col-span-2" data-reveal style="--reveal-delay: 120ms">
      <FaqList items={faqs.slice(0, 4)} />
    </div>
  </section>

  <CtaSection />
</Layout>
