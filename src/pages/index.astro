---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import ScrollHero from '../components/sections/home/ScrollHero.astro';
import AboutIntro from '../components/sections/home/AboutIntro.astro';
import FactoryGallery from '../components/sections/home/FactoryGallery.astro';
import ProductionGrid from '../components/sections/home/ProductionGrid.astro';
import ProcessSteps from '../components/sections/home/ProcessSteps.astro';
import GlobalNetwork from '../components/sections/home/GlobalNetwork.astro';
import Partners from '../components/sections/home/Partners.astro';
---

<Layout transparentHeader>
  <!-- 첫 화면: 스크롤하면 영상이 화면을 꽉 채움 -->
  <ScrollHero />

  <!-- 회사소개 (#about) -->
  <AboutIntro />

  <!-- 제작현황: 현장 사진 두 줄 (#works) -->
  <FactoryGallery />

  <!-- 제작 과정: 제목 + 4단계 네 칸 (#process) -->
  <ProcessSteps />

  <!-- 생산 분야: 번호 카드 6장 (#production) -->
  <ProductionGrid />

  <!-- 본사·지사 지도: 한국 → 중국 → 베트남 (#network) -->
  <GlobalNetwork />

  <!-- 함께한 업체 -->
  <Partners />

  <CtaSection />
</Layout>
