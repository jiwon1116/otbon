---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { guide as G, faqGroups } from '../data/site';

const num = (i: number) => String(i + 1).padStart(2, '0');
// 질문은 모두 같은 모양(+ 표시)으로 보여줌. 답이 비어 있으면 눌러도 펼쳐질 글이 없음
const groups = faqGroups;
---

<!--
  거래 안내 페이지 (메뉴 '거래 안내'). 문구는 src/data/site.ts 의 guide · faqGroups
  첫 화면 제목 → 거래 조건 → 자주 묻는 질문(주제별 묶음, 누르면 답이 펼쳐짐) → 견적 문의
  - 자주 묻는 질문: 큰 화면은 왼쪽에 주제(번호 · 영어 · 한글 · 설명)가 따라 내려오고 오른쪽에 질문 목록
-->
<Layout title={G.title} description="옷본의 샘플 · 패턴 개발비, 세금계산서, 불량 책임 등 거래 조건과 자주 묻는 질문을 안내합니다.">
  <section class="mx-auto max-w-7xl px-4 pb-20 pt-28 sm:px-6 lg:px-8 lg:pb-28">
    <p class="text-sm text-muted" data-reveal>
      <a href="/" class="transition-colors hover:text-ink">홈</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-ink">{G.title}</span>
    </p>
    <div class="mx-auto mt-16 max-w-3xl text-center lg:mt-20" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">{G.eyebrow}</p>
      <h1 class="mt-6 text-5xl font-bold tracking-tight sm:text-7xl">{G.title}</h1>
      <p class="mx-auto mt-7 max-w-xl leading-relaxed text-muted sm:text-lg">{G.lead}</p>
    </div>
  </section>

  <!-- 거래 조건: 번호 · 항목 · 설명 한 줄씩 -->
  <section id="terms" class="scroll-mt-20">
    <div class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-36">
      <div data-reveal>
        <p class="text-xs font-medium uppercase tracking-[0.25em] text-muted sm:text-sm">{G.termsEn}</p>
        <h2 class="mt-6 text-3xl font-semibold leading-snug tracking-tight sm:text-4xl">{G.termsTitle}</h2>
      </div>
      <ol class="mt-12 border-t border-ink/15 sm:mt-16">
        {G.terms.map((t, i) => (
          <li class="sd-row" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span class="sd-num">{num(i)}</span>
            <h3 class="text-lg font-semibold sm:text-xl">{t.title}</h3>
            <p class="text-[15px] leading-relaxed text-muted">{t.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 자주 묻는 질문: 질문을 누르면 답이 펼쳐짐 -->
  <section id="faq" class="scroll-mt-20">
    <div class="mx-auto max-w-7xl px-4 pb-28 sm:px-6 lg:px-8 lg:pb-40">
      <div data-reveal>
        <p class="text-xs font-medium uppercase tracking-[0.25em] text-muted sm:text-sm">{G.faqEn}</p>
        <h2 class="mt-6 text-3xl font-semibold leading-snug tracking-tight sm:text-4xl">{G.faqTitle}</h2>
      </div>
      <div class="mt-12 sm:mt-16">
        {groups.map((g, gi) => (
          <div class="gd-group">
            <div class="gd-group-head" data-reveal>
              <p class="gd-group-en"><span>{num(gi)}</span>{g.en}</p>
              <h3 class="gd-group-title">{g.title}</h3>
              <p class="gd-group-desc">{g.desc}</p>
            </div>
            <div class="gd-list">
              {g.items.map((f, i) => (
                <details class="gd-faq" data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 50}ms`} open={gi === 0 && i === 0}>
                  <summary>
                    <span class="gd-q">Q</span>
                    <span class="gd-qt">{f.q}</span>
                    <span class="gd-plus" aria-hidden="true"></span>
                  </summary>
                  {f.a.trim() && <p class="gd-a">{f.a}</p>}
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaSection />
</Layout>

<style>
  /* 거래 조건: 번호 · 항목 · 설명 한 줄씩 (휴대폰은 설명이 아래로) */
  .sd-num { font-size: 13px; font-weight: 600; color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .sd-row { display: grid; grid-template-columns: 3rem 1fr; gap: 8px 0; align-items: baseline; padding: 24px 0; border-bottom: 1px solid rgb(40 40 40 / 0.1); }
  .sd-row > p { grid-column: 2; }
  @media (min-width: 768px) {
    .sd-row { grid-template-columns: 4rem 14rem 1fr; }
    .sd-row > p { grid-column: auto; }
  }

  /* 질문 묶음: 위 진한 선. 큰 화면은 왼쪽 주제(따라 내려옴) · 오른쪽 질문 */
  .gd-group { display: grid; gap: 20px; padding: 36px 0 56px; border-top: 1px solid rgb(40 40 40 / 0.85); }
  .gd-group + .gd-group { margin-top: 8px; }
  @media (min-width: 1024px) {
    .gd-group { grid-template-columns: 4fr 8fr; gap: 64px; padding: 44px 0 72px; }
    .gd-group-head { position: sticky; top: 7rem; align-self: start; }
  }
  .gd-group-en { display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); }
  .gd-group-en span { font-variant-numeric: tabular-nums; color: var(--color-muted); letter-spacing: 0.05em; }
  .gd-group-title { margin-top: 14px; font-size: clamp(1.5rem, 2.4vw, 1.875rem); font-weight: 600; letter-spacing: -0.035em; }
  .gd-group-desc { margin-top: 8px; font-size: 14px; color: var(--color-muted); }
  .gd-list { border-top: 1px solid rgb(40 40 40 / 0.1); }
  @media (min-width: 1024px) { .gd-list { border-top: 0; } .gd-list .gd-faq:first-child summary { padding-top: 0; } }
  .gd-qt { font-size: 16px; font-weight: 600; line-height: 1.5; }
  @media (min-width: 640px) { .gd-qt { font-size: 17px; } }

  .gd-faq { border-bottom: 1px solid rgb(40 40 40 / 0.1); }
  .gd-faq summary { display: grid; grid-template-columns: 2.5rem 1fr 1.25rem; align-items: center; gap: 0 8px; padding: 22px 0; cursor: pointer; list-style: none; }
  .gd-faq summary::-webkit-details-marker { display: none; }  .gd-faq summary:hover { color: var(--color-accent); }
  .gd-q { font-size: 14px; font-weight: 700; color: var(--color-accent); }
  .gd-plus { position: relative; width: 16px; height: 16px; color: var(--color-accent); }
  .gd-plus::before, .gd-plus::after { content: ''; position: absolute; left: 0; right: 0; top: 7px; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.3s ease; }
  .gd-plus::after { transform: rotate(90deg); }
  .gd-faq[open] .gd-plus::after { transform: rotate(0deg); }
  .gd-a { margin: -4px 0 0 3rem; padding: 0 2rem 24px 0; max-width: 46rem; font-size: 15px; line-height: 1.75; color: var(--color-muted); }
</style>
